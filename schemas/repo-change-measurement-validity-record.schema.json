{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:repo-change-measurement-validity-record:1",
  "title": "Independent repository-SDLC measurement-validity record",
  "$comment": "The outcome executor must bind this record to the authenticated runner evidence, sealed workspace, exact cell and attempt, and complete receipt-fact projection; its verifier authority must be independent of both claimant and runner.",
  "type": "object",
  "required": [
    "schemaVersion", "id", "version", "experimentId", "caseId", "cellId", "attemptId", "armId",
    "workspaceManifestDigest", "workspaceRootDigest", "runnerEvidenceId", "runnerEvidenceDigest",
    "factProjectionDigest", "measurementValidity", "reasonCode", "verdict"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-eval-repo-change-measurement-validity-record-1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "const": "0.1.0" },
    "experimentId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "cellId": { "$ref": "#/$defs/id" },
    "attemptId": { "$ref": "#/$defs/id" },
    "armId": { "$ref": "#/$defs/id" },
    "workspaceManifestDigest": { "$ref": "#/$defs/digest" },
    "workspaceRootDigest": { "$ref": "#/$defs/digest" },
    "runnerEvidenceId": { "$ref": "#/$defs/id" },
    "runnerEvidenceDigest": { "$ref": "#/$defs/digest" },
    "factProjectionDigest": { "$ref": "#/$defs/digest" },
    "measurementValidity": { "enum": ["invalid", "not_assessable"] },
    "reasonCode": { "$ref": "#/$defs/id" },
    "verdict": { "const": "pass" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
