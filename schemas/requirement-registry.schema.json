{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The top-level digest is SHA-256 over the RFC 8785 canonical JSON projection with only the top-level digest omitted (full_document_without_digest).",
  "$id": "urn:agent-evals-standard:schema:requirement-registry:1",
  "title": "Closed normative requirement registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "standardVersion",
    "requirements",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-eval-requirement-registry-1"
    },
    "standardVersion": {
      "const": "0.1.0"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject",
          "normativeReference",
          "minimumLevel",
          "targets",
          "verificationKind",
          "verificationOwner",
          "accountableReviewer",
          "evidenceBasis",
          "applicability"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "normativeReference": {
            "type": "string",
            "minLength": 1
          },
          "minimumLevel": {
            "enum": [
              "A1",
              "A2"
            ]
          },
          "targets": {
            "type": "array",
            "minItems": 0,
            "items": {
              "enum": [
                "experiment",
                "decision"
              ]
            },
            "uniqueItems": true,
            "description": "Claim targets that must carry a result row for this requirement. An empty list means the requirement binds the maintainers of this standard, not a claimant, and never appears in a requirement-coverage matrix."
          },
          "verificationKind": {
            "enum": [
              "schema",
              "semantic",
              "manual_governance"
            ]
          },
          "verificationOwner": {
            "$ref": "#/$defs/id"
          },
          "accountableReviewer": {
            "$ref": "#/$defs/id"
          },
          "evidenceBasis": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "sourceIds"
                ],
                "properties": {
                  "kind": {
                    "const": "source_evidence"
                  },
                  "sourceIds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "threatRationale"
                ],
                "properties": {
                  "kind": {
                    "const": "design_invariant"
                  },
                  "threatRationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "applicability": {
            "type": "object",
            "required": [
              "rule",
              "unknownEffect"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "unknownEffect": {
                "enum": [
                  "fail",
                  "insufficient_evidence",
                  "manual_review_required"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
