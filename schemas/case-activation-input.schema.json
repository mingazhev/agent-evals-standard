{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:case-activation-input:1",
  "title": "Sealed Case QA activation input manifest",
  "$comment": "The manifest is hashed after canonicalization. Its projection is the case document with lifecycle and digest removed. The source case must first pass case.schema.json validation, including its lifecycle condition. The case pointer intentionally has no case digest: including the activated case digest would create a cycle because lifecycle.activationInputDigest is part of that document. Semantic validation must reconstruct the projection from the case and compare it byte-for-byte before accepting activation. This manifest binds inputs; it is not QA validity evidence.",
  "type": "object",
  "required": ["schemaVersion", "case", "projection"],
  "properties": {
    "schemaVersion": { "const": "agent-eval-activation-input-1" },
    "case": {
      "type": "object",
      "required": ["id", "version", "projectionDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1 },
        "projectionDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "required": [
        "schemaVersion", "caseVersion", "contracts", "id", "evaluationProfile", "outcomeProfile",
        "capabilityFamilyIds", "applicability", "source", "repository", "task",
        "agentVisibleProjection", "setupExecutors", "contamination", "leakageControls", "inherentRiskAssessment",
        "inherentRiskTier", "tags", "memberships", "sliceIds", "environment", "budgets", "validation",
        "claimRegistry", "interactionModeId", "workArtifactRegistry", "workArtifactTypes",
        "scoring", "artifactPolicy", "policy", "ownership"
      ],
      "properties": {
        "schemaVersion": { "const": "agent-eval-case-1" },
        "caseVersion": { "type": "string", "minLength": 1 },
        "id": { "$ref": "#/$defs/id" },
        "contracts": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/contracts" },
        "evaluationProfile": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/evaluationProfile" },
        "outcomeProfile": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/outcomeProfile" },
        "capabilityFamilyIds": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/capabilityFamilyIds" },
        "applicability": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/applicability" },
        "source": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/source" },
        "repository": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/repository" },
        "task": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/task" },
        "agentVisibleProjection": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/agentVisibleProjection" },
        "setupExecutors": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/setupExecutors" },
        "contamination": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/contamination" },
        "leakageControls": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/leakageControls" },
        "inherentRiskAssessment": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/inherentRiskAssessment" },
        "inherentRiskTier": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/inherentRiskTier" },
        "tags": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/tags" },
        "memberships": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/memberships" },
        "sliceIds": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/sliceIds" },
        "environment": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/environment" },
        "budgets": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/budgets" },
        "validation": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/validation" },
        "decisionSurfaces": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/decisionSurfaces" },
        "claimRegistry": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/claimRegistry" },
        "interactionModeId": { "enum": ["noninteractive_repository_task", "interactive_repository_session", "pull_request_workflow", "ci_or_release_workflow"] },
        "interactionProtocol": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/interactionProtocol" },
        "workArtifactRegistry": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/workArtifactRegistry" },
        "workArtifactTypes": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/workArtifactTypes" },
        "scoring": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/scoring" },
        "artifactPolicy": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/artifactPolicy" },
        "policy": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/policy" },
        "ownership": { "$ref": "urn:agent-evals-standard:schema:case:1#/properties/ownership" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
