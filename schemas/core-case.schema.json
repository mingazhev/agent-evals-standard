{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:core-case:1",
  "title": "Core-level evaluation case",
  "$comment": "Core obligations C2, C4, C5, and C6. Semantic checks outside JSON Schema: every hidden check and reference solution is absent from the agent-visible inputs and from the repository history at baseCommit.",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "author", "repository", "task", "capabilityFamilyId", "workArtifactType", "interactionModeId", "scopeTests", "acceptance", "oracleIsolation", "effectiveRisk"],
  "properties": {
    "schemaVersion": { "const": "agent-eval-core-case-1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1 },
    "author": { "$ref": "#/$defs/person" },
    "repository": {
      "type": "object",
      "required": ["uri", "baseCommit", "visibleHistory"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "baseCommit": { "$ref": "#/$defs/commit" },
        "visibleHistory": { "enum": ["none", "bounded", "full"] }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["statement", "agentVisibleInputs"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "agentVisibleInputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "capabilityFamilyId": { "enum": ["CAP.DISCOVER_SPECIFY", "CAP.PLAN_DESIGN", "CAP.IMPLEMENT_CHANGE", "CAP.VERIFY_ASSURE", "CAP.REVIEW_DECIDE", "CAP.RELEASE_OPERATE", "CAP.REMEDIATE_LEARN"] },
    "workArtifactType": { "enum": ["requirements_or_specification", "repository_analysis", "technical_plan_or_design", "code_change", "test_change", "repository_configuration", "assurance_report", "review_decision", "release_artifact", "operational_change_record", "incident_analysis", "prevention_plan"] },
    "interactionModeId": { "enum": ["noninteractive_repository_task", "interactive_repository_session", "pull_request_workflow", "ci_or_release_workflow"] },
    "scopeTests": {
      "$comment": "The four SCOPE-003 tests. A Core case must hold all four; the rationale is reviewed in Case QA.",
      "type": "object",
      "required": ["repositoryStateNecessary", "invariantsTraceToRepository", "changesRepositoryArtifactOrDecision", "removalChangesVerdict"],
      "properties": {
        "repositoryStateNecessary": { "$ref": "#/$defs/scopeTest" },
        "invariantsTraceToRepository": { "$ref": "#/$defs/scopeTest" },
        "changesRepositoryArtifactOrDecision": { "$ref": "#/$defs/scopeTest" },
        "removalChangesVerdict": { "$ref": "#/$defs/scopeTest" }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": ["successRule", "checks", "hardGates"],
      "properties": {
        "successRule": { "const": "all_checks_and_hard_gates_pass" },
        "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } },
        "hardGates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hardGate" } }
      },
      "additionalProperties": false
    },
    "oracleIsolation": {
      "type": "object",
      "required": ["hiddenMaterialLocation", "excludedFromAgentPaths", "excludedFromVisibleHistory", "method"],
      "properties": {
        "hiddenMaterialLocation": { "type": "string", "minLength": 1 },
        "excludedFromAgentPaths": { "const": true },
        "excludedFromVisibleHistory": { "const": true },
        "method": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "effectiveRisk": { "$ref": "#/$defs/risk" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$" },
    "person": {
      "type": "object",
      "required": ["id", "role"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "role": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "scopeTest": {
      "type": "object",
      "required": ["holds", "rationale"],
      "properties": { "holds": { "const": true }, "rationale": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["id", "kind", "visibility", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["deterministic", "expert_adjudication"] },
        "visibility": { "enum": ["agent_visible", "hidden"] },
        "description": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "rubric": { "type": "string", "minLength": 1 },
        "minimumIndependentRaters": { "type": "integer", "minimum": 2 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "deterministic" } } }, "then": { "properties": { "command": { "type": "string" } }, "required": ["command"] } },
        { "if": { "properties": { "kind": { "const": "expert_adjudication" } } }, "then": { "properties": { "rubric": { "type": "string" }, "minimumIndependentRaters": { "type": "integer" } }, "required": ["rubric", "minimumIndependentRaters"] } }
      ],
      "additionalProperties": false
    },
    "hardGate": {
      "type": "object",
      "required": ["id", "description", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": ["tier", "rationale"],
      "properties": { "tier": { "enum": ["low", "medium"] }, "rationale": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    }
  }
}
