{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:governance-decision:1",
  "title": "Governance decision record",
  "type": "object",
  "required": [
    "schemaVersion",
    "decisionId",
    "version",
    "decisionType",
    "verdict",
    "riskAssessment",
    "effectiveRiskTier",
    "policyInstance",
    "matrixInstance",
    "preRunDecisionPlan",
    "scorecards",
    "resolutionLedger",
    "enforcementReceipts",
    "effectiveAt",
    "reviewAt",
    "expiresAt",
    "roles",
    "separationOfDutiesEvidence",
    "conditionTrace",
    "approvalEnvelope",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-eval-governance-decision-1" },
    "decisionId": { "type": "string", "minLength": 1 },
    "version": { "const": "0.1.0" },
    "decisionType": { "enum": ["autonomy", "release", "risk_acceptance"] },
    "verdict": { "enum": ["approve", "reject", "insufficient_evidence"] },
    "riskAssessment": { "$comment": "The exact authenticated risk-assessment identity sealed in the pre-run manifest and reproduced by every decision-supporting scorecard.", "$ref": "#/$defs/versionedArtifactPointer" },
    "effectiveRiskTier": { "$comment": "Equals the exact tier in riskAssessment, the sealed pre-run manifest, and every decision-supporting scorecard.", "enum": ["low", "medium", "high", "critical"] },
    "policyInstance": { "$ref": "#/$defs/artifact" },
    "matrixInstance": { "$ref": "#/$defs/artifact" },
    "preRunDecisionPlan": { "$ref": "#/$defs/artifact" },
    "postDecisionAssurancePlan": { "$ref": "#/$defs/assurancePlan" },
    "scorecards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "resolutionLedger": { "$ref": "#/$defs/artifact" },
    "enforcementReceipts": { "$comment": "Semantic validation must bind every enforcement receipt relevant to the decision and reject duplicate receipt IDs.", "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "effectiveAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "reviewAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "expiresAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "roles": {
      "type": "object",
      "required": ["operator", "evidenceProducer", "approver", "securityApprover", "riskOwner", "statusResolver", "waiverAuthority", "rollbackVerifier"],
      "properties": {
        "operator": { "$ref": "#/$defs/actor" },
        "evidenceProducer": { "$ref": "#/$defs/actor" },
        "approver": { "$ref": "#/$defs/actor" },
        "securityApprover": { "$ref": "#/$defs/actor" },
        "riskOwner": { "$ref": "#/$defs/actor" },
        "statusResolver": { "$ref": "#/$defs/actor" },
        "waiverAuthority": { "$ref": "#/$defs/actor" },
        "rollbackVerifier": { "$ref": "#/$defs/actor" }
      },
      "additionalProperties": false
    },
    "separationOfDutiesEvidence": { "$ref": "#/$defs/artifact" },
    "conditionTrace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["conditionId", "sealedRequirement", "observedValue", "evidence", "evaluator", "verdict", "failureEffect"],
        "properties": {
          "conditionId": { "type": "string", "minLength": 1 },
          "sealedRequirement": { "type": "string", "minLength": 1 },
          "observedValue": {},
          "evidence": { "$ref": "#/$defs/artifact" },
          "evaluator": { "$ref": "#/$defs/actor" },
          "verdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
          "failureEffect": { "enum": ["reject", "insufficient_evidence"] }
        },
        "additionalProperties": false
      }
    },
    "approvalEnvelope": {
      "type": "object",
      "required": ["configurationHash", "taskScope", "repositoryScope", "environmentScope", "targetPopulation", "representedStrata", "exclusions", "tools", "autonomy"],
      "properties": {
        "configurationHash": { "$ref": "#/$defs/digest" },
        "taskScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "repositoryScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "environmentScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "targetPopulation": { "type": "string", "minLength": 1 },
        "representedStrata": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "autonomy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "signature": { "$ref": "urn:agent-evals-standard:schema:signature-profile:1#/$defs/signature" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "verdict": { "const": "approve" } }, "required": ["verdict"] },
      "then": {
        "type": "object",
        "required": ["postDecisionAssurancePlan"],
        "properties": { "postDecisionAssurancePlan": {}, "conditionTrace": { "type": "array", "items": { "type": "object", "properties": { "verdict": { "const": "pass" } } } } }
      }
    },
    {
      "if": { "type": "object", "properties": { "verdict": { "enum": ["reject", "insufficient_evidence"] } }, "required": ["verdict"] },
      "then": { "type": "object", "not": { "type": "object", "properties": { "postDecisionAssurancePlan": {} }, "required": ["postDecisionAssurancePlan"] } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "versionedArtifactPointer": {
      "type": "object",
      "required": ["id", "version", "uri", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["id", "location", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "verifiedArtifact": {
      "type": "object",
      "required": ["artifact", "schema", "verifier", "deterministic"],
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact" },
        "schema": { "$ref": "#/$defs/artifact" },
        "verifier": { "$ref": "#/$defs/component" },
        "deterministic": { "const": true }
      },
      "additionalProperties": false
    },
    "assurancePlan": {
      "type": "object",
      "required": ["artifact", "version", "approval", "triggers", "productionSignals", "samplingSchedule", "evidenceRetention", "owner", "sla", "missingEvidenceEffect"],
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact" },
        "version": { "type": "string", "minLength": 1 },
        "approval": { "$ref": "#/$defs/artifact" },
        "triggers": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": { "$ref": "#/$defs/assuranceTrigger" },
          "uniqueItems": true
        },
        "productionSignals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "outcome", "source", "unit", "direction", "signalContract", "calculationContract", "thresholdContract"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "outcome": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "unit": { "type": "string", "minLength": 1 },
              "direction": { "enum": ["lower_is_better", "higher_is_better", "two_sided"] },
              "signalContract": { "$ref": "#/$defs/verifiedArtifact" },
              "calculationContract": { "$ref": "#/$defs/verifiedArtifact" },
              "thresholdContract": { "$ref": "#/$defs/verifiedArtifact" }
            },
            "additionalProperties": false
          }
        },
        "samplingSchedule": {
          "type": "object",
          "required": ["contract", "cadence", "window", "anchorAt", "firstWindowStartsAt", "firstWindowEndsAt", "alignmentRule", "timeZone", "latenessSeconds", "targetPopulation", "samplingFrame", "missingnessPolicy", "minimumSampleSize"],
          "properties": {
            "contract": { "$ref": "#/$defs/verifiedArtifact" },
            "cadence": { "type": "string", "pattern": "^P(?=.*[1-9])(?=\\d|T\\d)(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+(?:\\.\\d+)?S)?)?$" },
            "window": { "type": "string", "pattern": "^P(?=.*[1-9])(?=\\d|T\\d)(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+(?:\\.\\d+)?S)?)?$" },
            "anchorAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
            "firstWindowStartsAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
            "firstWindowEndsAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
            "alignmentRule": { "const": "half_open_utc_windows" },
            "timeZone": { "const": "UTC" },
            "latenessSeconds": { "type": "integer", "minimum": 0 },
            "targetPopulation": { "type": "string", "minLength": 1 },
            "samplingFrame": { "type": "string", "minLength": 1 },
            "missingnessPolicy": { "enum": ["fail_closed", "pre_registered_bound"] },
            "minimumSampleSize": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "evidenceRetention": { "$ref": "#/$defs/verifiedArtifact" },
        "owner": { "$ref": "#/$defs/actor" },
        "sla": { "type": "string", "minLength": 1 },
        "missingEvidenceEffect": { "const": "suspend" }
      },
      "allOf": [
        { "$ref": "#/$defs/modelTriggerPresence" },
        { "$ref": "#/$defs/agentConfigurationTriggerPresence" },
        { "$ref": "#/$defs/promptTriggerPresence" },
        { "$ref": "#/$defs/harnessTriggerPresence" },
        { "$ref": "#/$defs/adapterTriggerPresence" },
        { "$ref": "#/$defs/toolSchemaTriggerPresence" },
        { "$ref": "#/$defs/toolImplementationTriggerPresence" },
        { "$ref": "#/$defs/permissionsTriggerPresence" },
        { "$ref": "#/$defs/environmentTriggerPresence" },
        { "$ref": "#/$defs/profileTriggerPresence" },
        { "$ref": "#/$defs/graderTriggerPresence" },
        { "$ref": "#/$defs/retrievalTriggerPresence" },
        { "$ref": "#/$defs/applicationScopeTriggerPresence" }
      ],
      "additionalProperties": false
    },
    "triggerPresence": { "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "type": "string" } }, "required": ["trigger"] }, "minContains": 1, "maxContains": 1 } } },
    "modelTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "model" } } } } } },
    "agentConfigurationTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "agent_configuration" } } } } } },
    "promptTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "prompt" } } } } } },
    "harnessTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "harness" } } } } } },
    "adapterTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "adapter" } } } } } },
    "toolSchemaTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "tool_schema" } } } } } },
    "toolImplementationTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "tool_implementation" } } } } } },
    "permissionsTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "permissions" } } } } } },
    "environmentTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "environment" } } } } } },
    "profileTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "profile" } } } } } },
    "graderTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "grader" } } } } } },
    "retrievalTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "retrieval" } } } } } },
    "applicationScopeTriggerPresence": { "$ref": "#/$defs/triggerPresence", "type": "object", "properties": { "triggers": { "type": "array", "contains": { "type": "object", "properties": { "trigger": { "const": "application_scope" } } } } } },
    "assuranceTrigger": {
      "type": "object",
      "required": ["trigger", "thresholdContract", "claimEffect", "stopAction", "scopeAction", "rollbackConditions", "revalidationConditions", "resumeConditions"],
      "properties": {
        "trigger": { "enum": ["model", "agent_configuration", "prompt", "harness", "adapter", "tool_schema", "tool_implementation", "permissions", "environment", "profile", "grader", "retrieval", "application_scope"] },
        "thresholdContract": { "$ref": "#/$defs/verifiedArtifact" },
        "claimEffect": { "enum": ["review", "narrow", "suspend", "revoke"] },
        "stopAction": { "enum": ["block_changed_scope", "suspend_approval", "block_acceptance"] },
        "scopeAction": { "enum": ["revalidate_or_revoke", "narrow_suspend_or_revoke", "rollback_or_reduce"] },
        "rollbackConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "revalidationConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "resumeConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
