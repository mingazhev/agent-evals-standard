{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:repo-change-runner-check-record:1",
  "title": "Runner-authenticated repository change check record",
  "$comment": "The outcome executor must bind workspaceManifestDigest and workspaceRootDigest to the authenticated case workspace, validationPlanDigest to the authenticated case document, subjectDigest to the exact workspace diff, registered-alternative terminal-evidence projection, or sealed workspace state as appropriate, require the exact applicable check ID/contract-digest set, and authenticate the producer through an externally configured runner authority.",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "experimentId", "caseId", "cellId", "attemptId", "armId", "workspaceManifestDigest", "workspaceRootDigest", "validationPlanDigest", "subjectKind", "subjectDigest", "checks", "overallVerdict"],
  "properties": {
    "schemaVersion": { "const": "agent-eval-repo-change-runner-check-record-1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "const": "0.1.0" },
    "experimentId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "cellId": { "$ref": "#/$defs/id" },
    "attemptId": { "$ref": "#/$defs/id" },
    "armId": { "$ref": "#/$defs/id" },
    "workspaceManifestDigest": { "$ref": "#/$defs/digest" },
    "workspaceRootDigest": { "$ref": "#/$defs/digest" },
    "validationPlanDigest": { "$ref": "#/$defs/digest" },
    "subjectKind": { "enum": ["workspace_diff", "registered_alternative_terminal_evidence", "workspace_state"] },
    "subjectDigest": { "$ref": "#/$defs/digest" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "contractDigest", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contractDigest": { "$ref": "#/$defs/digest" },
          "status": { "enum": ["pass", "fail", "invalid"] }
        },
        "additionalProperties": false
      }
    },
    "overallVerdict": { "enum": ["pass", "fail", "invalid"] }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
