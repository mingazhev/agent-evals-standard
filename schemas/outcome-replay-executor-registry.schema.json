{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:outcome-replay-executor-registry:1",
  "title": "Distribution-owned outcome replay executor registry",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "executors"],
  "properties": {
    "schemaVersion": { "const": "agent-eval-outcome-replay-executor-registry-1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "const": "0.1.0" },
    "executors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["outcomeProfileId", "outcomeProfile", "semanticContract", "executor", "classificationApplicabilityRule"],
        "properties": {
          "outcomeProfileId": { "$ref": "#/$defs/id" },
          "outcomeProfile": { "$ref": "#/$defs/artifactPointer" },
          "semanticContract": { "$ref": "#/$defs/artifactPointer" },
          "executor": { "$ref": "#/$defs/artifactPointer" },
          "classificationApplicabilityRule": { "$ref": "#/$defs/artifactPointer" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifactPointer": {
      "type": "object",
      "required": ["id", "version", "uri", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "const": "0.1.0" },
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
