{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:core-conformance-statement:1",
  "title": "Core-level conformance statement",
  "$comment": "Records one status per Core obligation C1-C13 in order. The verdict is derived: any fail yields nonconforming; otherwise any insufficient_evidence yields not_claimed; only thirteen pass rows yield core_conforming, which also requires a confirming review by a person independent of the issuer. Semantic checks: every evidence ref resolves at its commit; the reviewer is independent of the issuer under the glossary definition.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "standard",
    "level",
    "assuranceLevel",
    "issuer",
    "subject",
    "obligations",
    "restrictions",
    "independentReview",
    "verdict"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-eval-core-conformance-statement-1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "standard": {
      "type": "object",
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "const": "0.1.0"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      },
      "additionalProperties": false
    },
    "level": {
      "const": "core"
    },
    "assuranceLevel": {
      "const": "A1-lite"
    },
    "issuer": {
      "$ref": "#/$defs/person"
    },
    "subject": {
      "type": "object",
      "required": [
        "runManifest",
        "attemptLedger",
        "scorecard"
      ],
      "properties": {
        "runManifest": {
          "$ref": "#/$defs/ref"
        },
        "attemptLedger": {
          "$ref": "#/$defs/ref"
        },
        "scorecard": {
          "$ref": "#/$defs/ref"
        }
      },
      "additionalProperties": false
    },
    "obligations": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C1"
                },
                "requirementIds": {
                  "const": [
                    "SCOPE-001"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C2"
                },
                "requirementIds": {
                  "const": [
                    "SCOPE-003"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C3"
                },
                "requirementIds": {
                  "const": [
                    "I3"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C4"
                },
                "requirementIds": {
                  "const": [
                    "HOLD-001"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C5"
                },
                "requirementIds": {
                  "const": [
                    "I1",
                    "GATE-001"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C6"
                },
                "requirementIds": {
                  "const": [
                    "I9",
                    "JUDGE-002",
                    "JUDGE-003"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C7"
                },
                "requirementIds": {
                  "const": [
                    "I12",
                    "CASE-004"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C8"
                },
                "requirementIds": {
                  "const": [
                    "RUN-002"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C9"
                },
                "requirementIds": {
                  "const": [
                    "OUT-001",
                    "CLAIM-001",
                    "CLAIM-002",
                    "I6"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C10"
                },
                "requirementIds": {
                  "const": [
                    "STAT-001",
                    "STAT-003"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C11"
                },
                "requirementIds": {
                  "const": [
                    "STAT-002"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C12"
                },
                "requirementIds": {
                  "const": [
                    "VALID-003"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/obligation"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "C13"
                },
                "requirementIds": {
                  "const": [
                    "I7"
                  ]
                }
              },
              "required": [
                "id",
                "requirementIds"
              ]
            }
          ]
        }
      ],
      "items": false,
      "$comment": "Each item: id, requirementIds, status, and at least one evidence location."
    },
    "restrictions": {
      "type": "object",
      "required": [
        "governanceUse",
        "population",
        "incumbentComparison"
      ],
      "properties": {
        "governanceUse": {
          "const": "prohibited"
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "incumbentComparison": {
          "enum": [
            "not_claimed",
            "measured"
          ]
        }
      },
      "additionalProperties": false
    },
    "independentReview": {
      "type": "object",
      "required": [
        "reviewer",
        "verdict",
        "recordedAtCommit"
      ],
      "properties": {
        "reviewer": {
          "$ref": "#/$defs/person"
        },
        "verdict": {
          "enum": [
            "confirmed",
            "rejected"
          ]
        },
        "recordedAtCommit": {
          "$ref": "#/$defs/commit"
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "enum": [
        "core_conforming",
        "nonconforming",
        "not_claimed"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "verdict": {
            "const": "core_conforming"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "obligations": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "fail",
                      "insufficient_evidence"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "type": "array"
            }
          },
          "independentReview": {
            "properties": {
              "verdict": {
                "const": "confirmed"
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "obligations": {
            "contains": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "fail"
                }
              },
              "required": [
                "status"
              ]
            },
            "type": "array"
          }
        },
        "required": [
          "obligations"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "nonconforming"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "object",
      "required": [
        "path",
        "commit",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "person": {
      "type": "object",
      "required": [
        "id",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "obligation": {
      "type": "object",
      "required": [
        "id",
        "requirementIds",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "enum": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "C7",
            "C8",
            "C9",
            "C10",
            "C11",
            "C12",
            "C13"
          ]
        },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "insufficient_evidence"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
