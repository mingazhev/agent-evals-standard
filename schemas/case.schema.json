{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:case:1",
  "title": "Evaluation case",
  "$comment": "A1 requirements SCOPE-003, HOLD-001, I1, GATE-001, I9, JUDGE-002, JUDGE-003. effectiveRisk is the case's inherent-hazard classification; a case whose tier is high or critical may be scheduled only by an A3 run (checked against the run manifest, not here). Fields after effectiveRisk are optional here and required by prose at A2+. Semantic checks outside JSON Schema: every hidden check and reference solution is absent from the agent-visible inputs and from the repository history at baseCommit.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "author",
    "repository",
    "task",
    "capabilityFamilyId",
    "workArtifactType",
    "interactionModeId",
    "scopeTests",
    "acceptance",
    "oracleIsolation",
    "effectiveRisk"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-eval-case-1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "$ref": "#/$defs/person"
    },
    "repository": {
      "type": "object",
      "required": [
        "uri",
        "baseCommit",
        "visibleHistory"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "baseCommit": {
          "$ref": "#/$defs/commit"
        },
        "visibleHistory": {
          "enum": [
            "none",
            "bounded",
            "full"
          ]
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "statement",
        "agentVisibleInputs"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "agentVisibleInputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "capabilityFamilyId": {
      "enum": [
        "CAP.DISCOVER_SPECIFY",
        "CAP.PLAN_DESIGN",
        "CAP.IMPLEMENT_CHANGE",
        "CAP.VERIFY_ASSURE",
        "CAP.REVIEW_DECIDE",
        "CAP.RELEASE_OPERATE",
        "CAP.REMEDIATE_LEARN"
      ]
    },
    "workArtifactType": {
      "enum": [
        "requirements_or_specification",
        "repository_analysis",
        "technical_plan_or_design",
        "code_change",
        "test_change",
        "repository_configuration",
        "assurance_report",
        "review_decision",
        "release_artifact",
        "operational_change_record",
        "incident_analysis",
        "prevention_plan"
      ]
    },
    "interactionModeId": {
      "enum": [
        "noninteractive_repository_task",
        "interactive_repository_session",
        "pull_request_workflow",
        "ci_or_release_workflow"
      ]
    },
    "scopeTests": {
      "$comment": "The four SCOPE-003 tests. A Core case must hold all four; the rationale is reviewed in Case QA.",
      "type": "object",
      "required": [
        "repositoryStateNecessary",
        "invariantsTraceToRepository",
        "changesRepositoryArtifactOrDecision",
        "removalChangesVerdict"
      ],
      "properties": {
        "repositoryStateNecessary": {
          "$ref": "#/$defs/scopeTest"
        },
        "invariantsTraceToRepository": {
          "$ref": "#/$defs/scopeTest"
        },
        "changesRepositoryArtifactOrDecision": {
          "$ref": "#/$defs/scopeTest"
        },
        "removalChangesVerdict": {
          "$ref": "#/$defs/scopeTest"
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": [
        "successRule",
        "checks",
        "hardGates"
      ],
      "properties": {
        "successRule": {
          "const": "all_checks_and_hard_gates_pass"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "hardGates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hardGate"
          }
        }
      },
      "additionalProperties": false
    },
    "oracleIsolation": {
      "type": "object",
      "required": [
        "hiddenMaterialLocation",
        "excludedFromAgentPaths",
        "excludedFromVisibleHistory",
        "method"
      ],
      "properties": {
        "hiddenMaterialLocation": {
          "type": "string",
          "minLength": 1
        },
        "excludedFromAgentPaths": {
          "const": true
        },
        "excludedFromVisibleHistory": {
          "const": true
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "effectiveRisk": {
      "$ref": "#/$defs/risk"
    },
    "workspaceManifest": {
      "$comment": "A workspace-manifest-1 document; at A2+ replaces the plain repository.baseCommit identity.",
      "$ref": "#/$defs/ref"
    },
    "evaluationProfile": {
      "$ref": "#/$defs/versionedDigestRef"
    },
    "outcomeProfile": {
      "$ref": "#/$defs/versionedDigestRef"
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "active",
            "quarantined",
            "retired"
          ]
        },
        "qaRecord": {
          "$ref": "#/$defs/ref"
        },
        "quarantineRecord": {
          "$ref": "#/$defs/ref"
        }
      },
      "additionalProperties": false
    },
    "contamination": {
      "type": "object",
      "required": [
        "sourceVisibility",
        "previousEvaluationExposure",
        "trainingOrMemoryRisk"
      ],
      "properties": {
        "sourceVisibility": {
          "enum": [
            "private",
            "restricted",
            "public"
          ]
        },
        "previousEvaluationExposure": {
          "type": "string",
          "minLength": 1
        },
        "trainingOrMemoryRisk": {
          "enum": [
            "none_known",
            "low",
            "medium",
            "high",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "leakageControls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "artifactId",
          "description"
        ],
        "properties": {
          "type": {
            "enum": [
              "canary",
              "authenticated_access_telemetry",
              "matched_decoy"
            ]
          },
          "artifactId": {
            "$ref": "#/$defs/id"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "decisionSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decisionSurface"
      }
    },
    "exposureBudget": {
      "$ref": "#/$defs/ref"
    },
    "interactionProtocol": {
      "$ref": "#/$defs/ref"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "person": {
      "type": "object",
      "required": [
        "id",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scopeTest": {
      "type": "object",
      "required": [
        "holds",
        "rationale"
      ],
      "properties": {
        "holds": {
          "const": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "visibility",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "deterministic",
            "expert_adjudication"
          ]
        },
        "visibility": {
          "enum": [
            "agent_visible",
            "hidden"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "rubric": {
          "type": "string",
          "minLength": 1
        },
        "minimumIndependentRaters": {
          "type": "integer",
          "minimum": 2
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "deterministic"
              }
            }
          },
          "then": {
            "properties": {
              "command": {
                "type": "string"
              }
            },
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "expert_adjudication"
              }
            }
          },
          "then": {
            "properties": {
              "rubric": {
                "type": "string"
              },
              "minimumIndependentRaters": {
                "type": "integer"
              }
            },
            "required": [
              "rubric",
              "minimumIndependentRaters"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "hardGate": {
      "type": "object",
      "required": [
        "id",
        "description",
        "command"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "required": [
        "tier",
        "rationale"
      ],
      "properties": {
        "tier": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "object",
      "required": [
        "path",
        "commit",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "versionedDigestRef": {
      "$comment": "When used for evaluationProfile or outcomeProfile, digest is the target profile's declared self-digest projection: resolve the profile, recompute the projection, and verify its stored self-digest; do not hash raw stored file bytes. Uses for decisionSurface.applicabilityRule and coverageProof follow those target artifacts' own digest contracts.",
      "type": "object",
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "decisionSurface": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "materiality",
        "applicabilityRule",
        "unknownApplicabilityResult",
        "coverage",
        "rationale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "instruction_following",
            "functional_output",
            "tool_selection",
            "tool_arguments",
            "stop_or_escalation",
            "handoff",
            "context_management",
            "other"
          ]
        },
        "materiality": {
          "enum": [
            "outcome",
            "risk",
            "diagnostic"
          ]
        },
        "applicabilityRule": {
          "$ref": "#/$defs/versionedDigestRef"
        },
        "unknownApplicabilityResult": {
          "const": "indeterminate"
        },
        "coverage": {
          "enum": [
            "checked",
            "covered_by_final_state",
            "not_applicable",
            "declared_gap"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "checkIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "coverageProof": {
          "$ref": "#/$defs/versionedDigestRef"
        },
        "claimRestriction": {
          "$ref": "#/$defs/claimRestriction"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "coverage": {
                "const": "checked"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "checkIds": {},
              "coverageProof": {}
            },
            "required": [
              "checkIds",
              "coverageProof"
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "coverage": {
                "const": "covered_by_final_state"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "coverageProof": {}
            },
            "required": [
              "coverageProof"
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "coverage": {
                "const": "declared_gap"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "claimRestriction": {}
            },
            "required": [
              "claimRestriction"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "claimRestriction": {
      "type": "object",
      "required": [
        "effect",
        "affectedClaimIds",
        "scope",
        "rationale"
      ],
      "properties": {
        "effect": {
          "const": "insufficient_evidence"
        },
        "affectedClaimIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
