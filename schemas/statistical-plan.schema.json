{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:statistical-plan:1",
  "title": "Pre-registered statistical plan",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "sealedAt", "assuranceLevel", "runMode", "claimEligibility", "targetPopulation", "samplingFrame", "primaryClaims", "exploratoryClaims", "claimContracts", "samplingUnit", "minimumSampleRule", "powerOrPrecision", "randomization", "dependence", "invalidAndRetryHandling", "unresolvedCellPolicy", "multiplicity", "sequentialLooksAndStopping", "heldOutExposureAndReuse", "estimators", "intervalProcedure", "digest", "signature"],
  "properties": {
    "schemaVersion": { "const": "agent-eval-statistical-plan-1" },
    "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 }, "sealedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "assuranceLevel": { "enum": ["A0", "A1", "A2", "A3"] }, "runMode": { "enum": ["diagnostic_run", "evaluation"] }, "claimEligibility": { "enum": ["none", "claims_eligible"] },
    "targetPopulation": { "type": "string", "minLength": 1 }, "samplingFrame": { "$ref": "#/$defs/verifiedContract" },
    "primaryClaims": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "exploratoryClaims": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "claimContracts": {
      "$comment": "Closed pre-observation claim definitions. Semantic validation requires exactly one contract for every primary or exploratory claim, exact canonical caseIds/armIds equality, and eligibleCells equal to the complete ordered scheduled-cell tuple commitment. Post-hoc threshold, rule, estimand, success-predicate, missing, extra, subset, superset, undeclared, or passenger scope is invalid.",
      "type": "array", "items": { "$ref": "#/$defs/claimContract" }
    },
    "samplingUnit": { "const": "scheduled_cell" },
    "minimumSampleRule": { "$ref": "#/$defs/verifiedContract" },
    "powerOrPrecision": { "$ref": "#/$defs/verifiedContract" },
    "randomization": { "$ref": "#/$defs/verifiedContract" },
    "dependence": { "$ref": "#/$defs/verifiedContract" },
    "invalidAndRetryHandling": { "$ref": "#/$defs/verifiedContract" },
    "unresolvedCellPolicy": {
      "type": "object", "required": ["maximumRate", "maximumDifferentialRate", "boundMethod"],
      "properties": {
        "maximumRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximumDifferentialRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "boundMethod": { "$ref": "#/$defs/verifiedContract" }
      },
      "additionalProperties": false
    },
    "multiplicity": { "$ref": "#/$defs/verifiedContract" },
    "sequentialLooksAndStopping": { "$ref": "#/$defs/verifiedContract" },
    "heldOutExposureAndReuse": {
      "$comment": "The statistical plan binds both the material held-out budget and the current append-only ledger; a generic verifiedContract is insufficient.",
      "$ref": "urn:agent-evals-standard:schema:verified-machine-contract:1#/$defs/heldOutExposureControl"
    },
    "estimators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verifiedContract" } },
    "intervalProcedure": { "$ref": "#/$defs/verifiedContract" },
    "digest": { "$ref": "#/$defs/digest" },
    "signature": { "$ref": "urn:agent-evals-standard:schema:signature-profile:1#/$defs/signature" }
  },
  "allOf": [
    { "if": { "type": "object", "properties": { "assuranceLevel": { "const": "A0" } }, "required": ["assuranceLevel"] }, "then": { "type": "object", "properties": { "runMode": { "const": "diagnostic_run" }, "claimEligibility": { "const": "none" }, "primaryClaims": { "type": "array", "maxItems": 0 }, "exploratoryClaims": { "type": "array", "maxItems": 0 }, "claimContracts": { "type": "array", "maxItems": 0 } } }, "else": { "type": "object", "properties": { "runMode": { "const": "evaluation" }, "claimEligibility": { "const": "claims_eligible" }, "primaryClaims": { "type": "array", "minItems": 1 }, "claimContracts": { "type": "array", "minItems": 1 } } } }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "component": {
      "type": "object", "required": ["id", "version", "digest"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } },
      "additionalProperties": false
    },
    "successDefinition": {
      "type": "object", "required": ["id", "version"],
      "properties": { "id": { "enum": ["functional-outcome-v1", "accepted-outcome-v1"] }, "version": { "const": "0.1.0" } },
      "additionalProperties": false
    },
    "claimContract": {
      "type": "object",
      "required": ["claimId", "classification", "type", "estimand", "direction", "successDefinition", "analysisUnit", "threshold", "confidenceLevel", "minimumValidTrials", "caseIds", "armIds", "eligibleCells", "decisionRule"],
      "properties": {
        "claimId": { "$ref": "#/$defs/id" },
        "classification": { "enum": ["primary", "exploratory"] },
        "type": { "type": "string", "pattern": "^(capability|reliability|comparative|quality|safety|cost|governance_evidence|[A-Za-z0-9][A-Za-z0-9_.-]*:[A-Za-z0-9_.-]+)$" },
        "estimand": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["positive", "harm", "difference"] },
        "successDefinition": { "$ref": "#/$defs/successDefinition" },
        "analysisUnit": { "type": "string", "minLength": 1 },
        "threshold": { "type": ["number", "null"] },
        "confidenceLevel": { "type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "minimumValidTrials": { "type": "integer", "minimum": 1 },
        "caseIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "armIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "eligibleCells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/eligibleCell" }, "uniqueItems": true },
        "decisionRule": { "$ref": "#/$defs/component" }
      },
      "additionalProperties": false
    },
    "eligibleCell": {
      "type": "object",
      "required": ["cellId", "caseId", "armId", "repetition", "blockId", "seed"],
      "properties": {
        "cellId": { "$ref": "#/$defs/id" },
        "caseId": { "$ref": "#/$defs/id" },
        "armId": { "$ref": "#/$defs/id" },
        "repetition": { "type": "integer", "minimum": 1 },
        "blockId": { "$ref": "#/$defs/id" },
        "seed": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "verifiedContract": {
      "type": "object", "required": ["id", "version", "digest", "schemaId", "verifierDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" },
        "schemaId": { "$ref": "#/$defs/id" }, "verifierDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
