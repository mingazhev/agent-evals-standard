{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:repo-change-assurance-report:1",
  "title": "Evaluated-arm repository-change assurance report",
  "$comment": "This is the material work product emitted by the evaluated arm and captured by the runner during execution. Its own verdict is not grading truth; an independent grader assessment and outcome-replay receipt evaluate it.",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "experimentId", "caseId", "cellId", "attemptId", "armId", "workspaceDiffDigest", "reportVerdict", "summary", "checks"],
  "properties": {
    "schemaVersion": { "const": "agent-eval-repo-change-assurance-report-1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "const": "0.1.0" },
    "experimentId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "cellId": { "$ref": "#/$defs/id" },
    "attemptId": { "$ref": "#/$defs/id" },
    "armId": { "$ref": "#/$defs/id" },
    "workspaceDiffDigest": { "$ref": "#/$defs/digest" },
    "reportVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
    "summary": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidenceRefs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["pass", "fail", "insufficient_evidence"] },
          "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
