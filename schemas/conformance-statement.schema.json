{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:conformance-statement:1",
  "title": "Conformance statement",
  "$comment": "One requirementResults row per registry requirement whose minimumLevel is at most the declared assuranceLevel and whose targets contain the claim; the registry, not this schema, pins the list. The verdict is derived: any fail yields nonconforming; otherwise any insufficient_evidence yields not_claimed; otherwise conforming, which also requires a confirming review by a person independent of the issuer. validationEnvelope is required at A2 and above. Semantic checks: every evidence ref resolves at its commit; the reviewer is independent of the issuer under the glossary definition.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "standard",
    "assuranceLevel",
    "claim",
    "issuer",
    "subject",
    "requirementResults",
    "restrictions",
    "independentReview",
    "verdict"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-eval-conformance-statement-1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "standard": {
      "type": "object",
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "const": "0.1.0"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      },
      "additionalProperties": false
    },
    "assuranceLevel": {
      "enum": [
        "A1",
        "A2",
        "A3"
      ]
    },
    "claim": {
      "enum": [
        "experiment",
        "decision"
      ]
    },
    "issuer": {
      "$ref": "#/$defs/person"
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "runManifest",
            "attemptLedger",
            "scorecard"
          ],
          "properties": {
            "runManifest": {
              "$ref": "#/$defs/ref"
            },
            "attemptLedger": {
              "$ref": "#/$defs/ref"
            },
            "scorecard": {
              "$ref": "#/$defs/ref"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "governanceDecision",
            "scorecard"
          ],
          "properties": {
            "governanceDecision": {
              "$ref": "#/$defs/ref"
            },
            "scorecard": {
              "$ref": "#/$defs/ref"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "requirementResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirementResult"
      }
    },
    "validationEnvelope": {
      "$ref": "#/$defs/ref"
    },
    "restrictions": {
      "type": "object",
      "required": [
        "governanceUse",
        "population",
        "incumbentComparison"
      ],
      "properties": {
        "governanceUse": {
          "const": "prohibited"
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "incumbentComparison": {
          "enum": [
            "not_claimed",
            "measured"
          ]
        }
      },
      "additionalProperties": false
    },
    "independentReview": {
      "type": "object",
      "required": [
        "reviewer",
        "verdict",
        "recordedAtCommit"
      ],
      "properties": {
        "reviewer": {
          "$ref": "#/$defs/person"
        },
        "verdict": {
          "enum": [
            "confirmed",
            "rejected"
          ]
        },
        "recordedAtCommit": {
          "$ref": "#/$defs/commit"
        }
      },
      "additionalProperties": false
    },
    "verdict": {
      "enum": [
        "conforming",
        "nonconforming",
        "not_claimed"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim": {
            "const": "experiment"
          }
        },
        "required": [
          "claim"
        ]
      },
      "then": {
        "properties": {
          "subject": {
            "required": [
              "runManifest"
            ],
            "type": "object",
            "properties": {
              "runManifest": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim": {
            "const": "decision"
          }
        },
        "required": [
          "claim"
        ]
      },
      "then": {
        "properties": {
          "subject": {
            "required": [
              "governanceDecision"
            ],
            "type": "object",
            "properties": {
              "governanceDecision": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "conforming"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "requirementResults": {
            "not": {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "fail",
                      "insufficient_evidence"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "independentReview": {
            "type": "object",
            "properties": {
              "verdict": {
                "const": "confirmed"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requirementResults": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "fail"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        },
        "required": [
          "requirementResults"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "nonconforming"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "object",
      "required": [
        "path",
        "commit",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "person": {
      "type": "object",
      "required": [
        "id",
        "role"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "requirementResult": {
      "type": "object",
      "required": [
        "requirementId",
        "status",
        "evidence"
      ],
      "properties": {
        "requirementId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "insufficient_evidence"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
