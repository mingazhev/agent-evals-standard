{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:attempt-ledger:1",
  "title": "Hash-chained attempt ledger",
  "$comment": "Obligation C8 (RUN-002). entryDigest is sha256 of RFC 8785 JCS of the entry without entryDigest; previousEntryDigest is the prior entry's entryDigest, and for the first entry the digest of the run manifest ref {path, commit, digest}; terminalDigest is the last entryDigest. Semantic checks: sequences are contiguous from 1; every scheduled cell of the run manifest appears; a replacement names an earlier invalid attempt of the same cell; at most the sealed number of replacements per cell.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "runManifest",
    "chainAlgorithm",
    "entries",
    "terminalDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-eval-attempt-ledger-1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "runManifest": {
      "$ref": "#/$defs/ref"
    },
    "chainAlgorithm": {
      "const": "sha256-jcs-entry-chain-v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "terminalDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "ref": {
      "type": "object",
      "required": [
        "path",
        "commit",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "sequence",
        "attemptId",
        "cellId",
        "caseId",
        "armId",
        "trial",
        "replacesAttemptId",
        "startedAt",
        "finishedAt",
        "validity",
        "primaryOutcome",
        "hardGates",
        "evidenceDigest",
        "previousEntryDigest",
        "entryDigest"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "attemptId": {
          "$ref": "#/$defs/id"
        },
        "cellId": {
          "$ref": "#/$defs/id"
        },
        "caseId": {
          "$ref": "#/$defs/id"
        },
        "armId": {
          "$ref": "#/$defs/id"
        },
        "trial": {
          "type": "integer",
          "minimum": 1
        },
        "replacesAttemptId": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "finishedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "validity": {
          "enum": [
            "valid",
            "invalid_infrastructure",
            "invalid_capture"
          ]
        },
        "primaryOutcome": {
          "enum": [
            "solved",
            "correct_refusal",
            "already_satisfied",
            "partial",
            "failed",
            "no_relevant_result",
            "unsafe_policy_violation",
            null
          ]
        },
        "hardGates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "evidenceDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "previousEntryDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "entryDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validity": {
                "const": "valid"
              }
            }
          },
          "then": {
            "properties": {
              "primaryOutcome": {
                "type": "string"
              },
              "evidenceDigest": {
                "$ref": "#/$defs/digest"
              },
              "hardGates": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "primaryOutcome": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "validity": {
                "const": "valid"
              },
              "hardGates": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "fail"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            },
            "required": [
              "validity",
              "hardGates"
            ]
          },
          "then": {
            "properties": {
              "primaryOutcome": {
                "enum": [
                  "unsafe_policy_violation",
                  "failed",
                  "partial",
                  "no_relevant_result"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
