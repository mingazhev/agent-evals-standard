{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:distribution-manifest:1",
  "title": "Exact standard distribution manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "kind", "entries", "entriesDigest"],
  "properties": {
    "schemaVersion": { "const": "agent-eval-distribution-manifest-1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "const": "0.1.0" },
    "kind": { "enum": ["schemas", "contracts"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "uri", "digest"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "pattern": "^(?:(?:schemas|profiles)/(?:[^/\\\\]+/)*[^/\\\\]+\\.json|profiles/(?:[^/\\\\]+/)*[^/\\\\]+-contract\\.md|standard/(?:[^/\\\\]+/)*[^/\\\\]+\\.(?:json|md))$" },
          "digest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    },
    "entriesDigest": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
