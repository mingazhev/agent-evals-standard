{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:governance-resolution:1",
  "title": "Governance resolution payload",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "action",
    "sourceEventId",
    "sourceEventType",
    "sourceEventHash",
    "sourceTriageArtifact",
    "sourceFindingRef",
    "governanceStatusId",
    "riskTier",
    "waivability",
    "scorecardId",
    "scorecardHash",
    "policyInstanceHash",
    "matrixInstanceHash",
    "enforcementReceipt",
    "actor",
    "policyClause",
    "scope",
    "evidence",
    "separationOfDutiesEvidence",
    "timestamp",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-eval-governance-resolution-1" },
    "eventId": { "type": "string", "minLength": 1 },
    "action": { "enum": ["resolve", "waive", "expire", "narrow", "renew", "rollback", "supersede"] },
    "sourceEventId": { "type": "string", "minLength": 1 },
    "sourceEventType": { "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/eventId" },
    "sourceEventHash": { "$ref": "#/$defs/digest" },
    "sourceTriageArtifact": { "type": "string", "minLength": 1 },
    "sourceFindingRef": { "type": "string", "minLength": 1 },
    "governanceStatusId": { "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/escalationGovernanceStatus" },
    "riskTier": { "enum": ["low", "medium", "high", "critical"] },
    "waivability": { "enum": ["waivable", "non_waivable"] },
    "scorecardId": { "type": "string", "minLength": 1 },
    "scorecardHash": { "$ref": "#/$defs/digest" },
    "findingId": { "type": "string", "minLength": 1 },
    "policyInstanceHash": { "$ref": "#/$defs/digest" },
    "matrixInstanceHash": { "$ref": "#/$defs/digest" },
    "enforcementReceipt": { "$ref": "#/$defs/artifactPointer" },
    "actor": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "policyClause": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "separationOfDutiesEvidence": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "expiresAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "signature": { "$ref": "urn:agent-evals-standard:schema:signature-profile:1#/$defs/signature" }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "enum": ["resolve", "waive"] } }, "required": ["action"] },
      "then": { "type": "object", "properties": { "findingId": {} }, "required": ["findingId"] }
    },
    {
      "if": { "properties": { "action": { "enum": ["waive", "renew"] } }, "required": ["action"] },
      "then": { "type": "object", "properties": { "expiresAt": {} }, "required": ["expiresAt"] }
    },
    {
      "if": { "properties": { "action": { "const": "waive" } }, "required": ["action"] },
      "then": { "properties": { "waivability": { "const": "waivable" } } }
    },
    {
      "if": { "properties": { "sourceEventType": { "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/waivableEventId" } }, "required": ["sourceEventType"] },
      "then": { "properties": { "waivability": { "const": "waivable" } } }
    },
    {
      "if": { "properties": { "sourceEventType": { "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/nonWaivableEventId" } }, "required": ["sourceEventType"] },
      "then": {
        "properties": {
          "waivability": { "const": "non_waivable" },
          "action": { "not": { "const": "waive" } }
        }
      }
    },
    {
      "if": { "properties": { "sourceEventType": { "enum": ["approvedConfigurationChanged", "assuranceEvidenceMissing"] } }, "required": ["sourceEventType"] },
      "then": {
        "properties": {
          "action": { "enum": ["resolve", "narrow", "rollback", "supersede"] }
        }
      }
    },
    {
      "if": { "properties": { "sourceEventType": { "enum": ["productionConcordanceDegraded", "productionMonitoringBreach"] } }, "required": ["sourceEventType"] },
      "then": { "properties": { "action": { "enum": ["resolve", "narrow", "rollback", "supersede"] } } }
    },
    {
      "if": { "properties": { "sourceEventType": { "enum": ["suspectedContamination", "privacyIpRetentionBreach"] } }, "required": ["sourceEventType"] },
      "then": { "properties": { "action": { "enum": ["resolve", "narrow", "supersede"] } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifactPointer": { "type": "object", "required": ["id", "uri", "digest"], "properties": { "id": { "type": "string", "minLength": 1 }, "uri": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false }
  }
}
