{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:repo-change-grader-assessment:1",
  "title": "Independent grader assessment of repository-change outputs",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "experimentId", "caseId", "cellId", "attemptId", "armId", "workspaceDiffDigest", "evaluatedAssuranceReportDigest", "checks", "facts"],
  "properties": {
    "schemaVersion": { "const": "agent-eval-repo-change-grader-assessment-1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "const": "0.1.0" },
    "experimentId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "cellId": { "$ref": "#/$defs/id" },
    "attemptId": { "$ref": "#/$defs/id" },
    "armId": { "$ref": "#/$defs/id" },
    "workspaceDiffDigest": { "$ref": "#/$defs/digest" },
    "evaluatedAssuranceReportDigest": { "$ref": "#/$defs/digest" },
    "checks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["pass", "fail", "insufficient_evidence"] }
        },
        "additionalProperties": false
      }
    },
    "facts": { "$ref": "urn:agent-evals-standard:schema:outcome-replay-receipt:1#/$defs/facts" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
