{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:escalation-event:1",
  "title": "Operational escalation event",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "eventId",
    "matrixVersion",
    "matrixHash",
    "matrixRowHash",
    "triggeredAt",
    "state",
    "affectedScope",
    "claimEffect",
    "governanceStatus",
    "stopAction",
    "scopeAction",
    "waivable",
    "owner",
    "sla",
    "triageArtifact",
    "findingRef",
    "evidence",
    "enforcementRequest",
    "resumeConditions",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-eval-escalation-event-1" },
    "id": { "type": "string", "minLength": 1 },
    "eventId": { "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/eventId" },
    "matrixVersion": { "type": "string", "minLength": 1 },
    "matrixHash": { "$ref": "#/$defs/digest" },
    "matrixRowHash": { "$ref": "#/$defs/digest" },
    "triggeredAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "state": { "const": "open" },
    "affectedScope": { "type": "object", "required": ["scopeDigest", "riskTier", "claimIds"], "properties": { "scopeDigest": { "$ref": "#/$defs/digest" }, "riskTier": { "enum": ["low", "medium", "high", "critical"] }, "decisionId": { "type": "string", "minLength": 1 }, "scorecardId": { "type": "string", "minLength": 1 }, "claimIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }, "additionalProperties": false },
    "claimEffect": { "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/claimEffect" },
    "governanceStatus": { "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/escalationGovernanceStatus" },
    "stopAction": { "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/stopAction" },
    "scopeAction": { "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/scopeAction" },
    "waivable": { "type": "boolean" },
    "owner": { "type": "string", "minLength": 1 },
    "sla": { "type": "string", "minLength": 1 },
    "triageArtifact": { "type": "string", "minLength": 1 },
    "findingRef": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "enforcementRequest": { "$comment": "Semantic validation must require action to equal stopAction. The later receipt is a separate immutable artifact and must not be inserted into this event.", "type": "object", "required": ["action", "requestedAt"], "properties": { "action": { "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/stopAction" }, "requestedAt": { "type": "string", "format": "date-time", "pattern": "Z$" } }, "additionalProperties": false },
    "resumeConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "signature": { "$ref": "urn:agent-evals-standard:schema:signature-profile:1#/$defs/signature" }
  },
  "allOf": [{ "$ref": "urn:agent-evals-standard:schema:escalation-event-registry:1#/$defs/eventTuple" }],
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
