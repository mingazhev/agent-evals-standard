{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:attempt-checkpoint:1",
  "title": "Independent append-only attempt checkpoint",
  "$comment": "The checkpoint is terminal scheduler evidence, not a scorecard self-assertion. Receipt digests and signatures use the projections defined by the Scorecard Contract. The checkpoint digest excludes top-level digest and signature; its signature projection omits only signature.value.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "experimentId",
    "scheduledSetCommitment",
    "ledger",
    "issuer",
    "logBinding",
    "checkpointKind",
    "receiptChainAlgorithm",
    "ledgerRootAlgorithm",
    "receipts",
    "terminalBinding",
    "issuedAt",
    "digest",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "agent-eval-attempt-checkpoint-1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "const": "0.1.0" },
    "experimentId": { "$ref": "#/$defs/id" },
    "scheduledSetCommitment": { "$ref": "#/$defs/artifactPointer" },
    "ledger": { "$ref": "#/$defs/artifactPointer" },
    "issuer": {
      "type": "object",
      "required": ["id", "role", "trustDomain"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "const": "independent_scheduler" },
        "trustDomain": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "logBinding": {
      "$comment": "publicationUri identifies the externally discoverable append-only log. Semantic verification obtains trust and the current terminal sequence outside the scorecard.",
      "type": "object",
      "required": ["logId", "checkpointSequence", "previousCheckpointDigest", "publicationUri"],
      "properties": {
        "logId": { "$ref": "#/$defs/id" },
        "checkpointSequence": { "type": "integer", "minimum": 1 },
        "previousCheckpointDigest": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/digest" }
          ]
        },
        "publicationUri": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "checkpointKind": { "const": "terminal" },
    "receiptChainAlgorithm": { "const": "sha256-jcs-receipts-v1" },
    "ledgerRootAlgorithm": { "const": "sha256-jcs-chain-v1" },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attemptReceipt" }
    },
    "terminalBinding": {
      "type": "object",
      "required": [
        "receiptCount",
        "terminalReceiptDigest",
        "orderedAttemptIdsDigest",
        "attemptRecordsDigest",
        "initialLedgerRoot",
        "terminalLedgerRoot",
        "closedAt"
      ],
      "properties": {
        "receiptCount": { "type": "integer", "minimum": 1 },
        "terminalReceiptDigest": { "$ref": "#/$defs/digest" },
        "orderedAttemptIdsDigest": { "$ref": "#/$defs/digest" },
        "attemptRecordsDigest": { "$ref": "#/$defs/digest" },
        "initialLedgerRoot": { "$ref": "#/$defs/digest" },
        "terminalLedgerRoot": { "$ref": "#/$defs/digest" },
        "closedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }
      },
      "additionalProperties": false
    },
    "issuedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "digest": { "$ref": "#/$defs/digest" },
    "signature": { "$ref": "urn:agent-evals-standard:schema:signature-profile:1#/$defs/signature" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifactPointer": {
      "type": "object",
      "required": ["id", "uri", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "attemptReceipt": {
      "$comment": "receiptDigest is SHA-256 over RFC 8785 JCS of this receipt with receiptDigest and signature removed. Signing bytes are ASCII agent-evals-attempt-receipt-1, a zero byte, and JCS of this receipt with only signature.value omitted.",
      "type": "object",
      "required": [
        "sequence",
        "experimentId",
        "scheduledSetCommitmentDigest",
        "attemptId",
        "cellId",
        "parentAttemptId",
        "startedAt",
        "previousReceiptDigest",
        "receiptDigest",
        "signature"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "experimentId": { "$ref": "#/$defs/id" },
        "scheduledSetCommitmentDigest": { "$ref": "#/$defs/digest" },
        "attemptId": { "$ref": "#/$defs/id" },
        "cellId": { "$ref": "#/$defs/id" },
        "parentAttemptId": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/id" }
          ]
        },
        "startedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "previousReceiptDigest": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/digest" }
          ]
        },
        "receiptDigest": { "$ref": "#/$defs/digest" },
        "signature": { "$ref": "urn:agent-evals-standard:schema:signature-profile:1#/$defs/signature" }
      },
      "additionalProperties": false
    }
  }
}
