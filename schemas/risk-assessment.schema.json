{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:risk-assessment:1",
  "title": "Sealed repository SDLC risk assessment",
  "$comment": "RISK-001 semantic validation authenticates the record, recomputes factorInputDigest from factors, executes maximum_applicable_tier_v1, and requires effectiveRiskTier to equal the highest applicable factor or uncertainty upper-bound tier. A profile effectiveRiskRange is only an eligibility boundary and is never an observed or derived tier.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "assessmentKind",
    "scope",
    "factors",
    "derivation",
    "effectiveRiskTier",
    "approval",
    "digest",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "risk-assessment-1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "const": "0.1.0" },
    "assessmentKind": { "enum": ["case_inherent_hazard", "experiment_envelope", "experiment_decision_envelope"] },
    "scope": {
      "$comment": "For experiment_decision_envelope, semantic validation requires exact caseIds and armIds equality with the consuming sealed pre-run manifest and decisionEnvelopeId equality with its decision plan.",
      "type": "object",
      "required": ["caseIds", "armIds", "decisionEnvelopeId"],
      "properties": {
        "caseIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "armIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "decisionEnvelopeId": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    },
    "factors": {
      "type": "object",
      "required": [
        "inherentHazards",
        "dataSensitivityAndAssets",
        "autonomyPermissionsToolsAndReversibility",
        "executionAndDeploymentEnvironment",
        "scopeBlastRadiusExposureAndOversight",
        "likelihoodAndUncertainty"
      ],
      "properties": {
        "inherentHazards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "description", "plausibleHarm", "severity", "tier", "evidence"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "description": { "type": "string", "minLength": 1 },
              "plausibleHarm": { "type": "string", "minLength": 1 },
              "severity": { "enum": ["negligible", "minor", "serious", "severe", "catastrophic"] },
              "tier": { "$ref": "#/$defs/tier" },
              "evidence": { "$ref": "#/$defs/evidenceSet" }
            },
            "additionalProperties": false
          }
        },
        "dataSensitivityAndAssets": {
          "type": "object",
          "required": ["classification", "affectedAssets", "tier", "evidence"],
          "properties": {
            "classification": { "type": "string", "minLength": 1 },
            "affectedAssets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "tier": { "$ref": "#/$defs/tier" },
            "evidence": { "$ref": "#/$defs/evidenceSet" }
          },
          "additionalProperties": false
        },
        "autonomyPermissionsToolsAndReversibility": {
          "type": "object",
          "required": ["autonomy", "permissions", "tools", "reversibility", "tier", "evidence"],
          "properties": {
            "autonomy": { "type": "string", "minLength": 1 },
            "permissions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "tools": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "reversibility": { "enum": ["fully_reversible", "partially_reversible", "irreversible"] },
            "tier": { "$ref": "#/$defs/tier" },
            "evidence": { "$ref": "#/$defs/evidenceSet" }
          },
          "additionalProperties": false
        },
        "executionAndDeploymentEnvironment": {
          "type": "object",
          "required": ["executionEnvironment", "deploymentEnvironment", "tier", "evidence"],
          "properties": {
            "executionEnvironment": { "type": "string", "minLength": 1 },
            "deploymentEnvironment": { "type": "string", "minLength": 1 },
            "tier": { "$ref": "#/$defs/tier" },
            "evidence": { "$ref": "#/$defs/evidenceSet" }
          },
          "additionalProperties": false
        },
        "scopeBlastRadiusExposureAndOversight": {
          "type": "object",
          "required": ["scope", "blastRadius", "exposureDurationSeconds", "humanOversight", "tier", "evidence"],
          "properties": {
            "scope": { "type": "string", "minLength": 1 },
            "blastRadius": { "type": "string", "minLength": 1 },
            "exposureDurationSeconds": { "type": "integer", "minimum": 0 },
            "humanOversight": { "enum": ["continuous", "checkpointed", "on_exception", "none"] },
            "tier": { "$ref": "#/$defs/tier" },
            "evidence": { "$ref": "#/$defs/evidenceSet" }
          },
          "additionalProperties": false
        },
        "likelihoodAndUncertainty": {
          "type": "object",
          "required": ["likelihood", "uncertainty", "tier", "upperApplicableTier", "evidence"],
          "properties": {
            "likelihood": { "enum": ["rare", "unlikely", "possible", "likely", "almost_certain"] },
            "uncertainty": { "enum": ["bounded_within_tier", "crosses_tier_boundary"] },
            "tier": { "$ref": "#/$defs/tier" },
            "upperApplicableTier": { "$ref": "#/$defs/tier" },
            "evidence": { "$ref": "#/$defs/evidenceSet" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "derivation": {
      "type": "object",
      "required": ["policy", "algorithm", "factorInputDigest", "evidence", "derivedAt", "derivedBy"],
      "properties": {
        "policy": { "$ref": "#/$defs/versionedArtifactPointer" },
        "algorithm": { "const": "maximum_applicable_tier_v1" },
        "factorInputDigest": { "$ref": "#/$defs/digest" },
        "evidence": { "$ref": "#/$defs/evidenceSet" },
        "derivedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "derivedBy": { "$ref": "#/$defs/actor" }
      },
      "additionalProperties": false
    },
    "effectiveRiskTier": { "$ref": "#/$defs/tier" },
    "approval": {
      "type": "object",
      "required": ["riskOwner", "approvedAt", "evidence"],
      "properties": {
        "riskOwner": { "$ref": "#/$defs/actor" },
        "approvedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "evidence": { "$ref": "#/$defs/artifactPointer" }
      },
      "additionalProperties": false
    },
    "digest": { "$ref": "#/$defs/digest" },
    "signature": { "$ref": "urn:agent-evals-standard:schema:signature-profile:1#/$defs/signature" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "assessmentKind": { "const": "case_inherent_hazard" } }, "required": ["assessmentKind"] },
      "then": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "armIds": { "type": "array", "maxItems": 0 },
              "decisionEnvelopeId": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "assessmentKind": { "const": "experiment_envelope" } }, "required": ["assessmentKind"] },
      "then": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "armIds": { "type": "array", "minItems": 1 },
              "decisionEnvelopeId": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "assessmentKind": { "const": "experiment_decision_envelope" } }, "required": ["assessmentKind"] },
      "then": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "object",
            "properties": {
              "armIds": { "type": "array", "minItems": 1 },
              "decisionEnvelopeId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "tier": { "enum": ["low", "medium", "high", "critical"] },
    "actor": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifactPointer": {
      "type": "object",
      "required": ["id", "uri", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "versionedArtifactPointer": {
      "type": "object",
      "required": ["id", "version", "uri", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "const": "0.1.0" },
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "evidenceSet": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifactPointer" },
      "uniqueItems": true
    }
  }
}
