{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:outcome-replay-receipt:1",
  "title": "Independent binding receipt for distribution-owned outcome replay",
  "$comment": "This payload is not authoritative by itself. A verifier must obtain its trust root outside the scorecard and receipt, resolve the registered executor, and replay all derived predicates. The receipt binds the exact authenticated suite case, scheduled cell, independently graded trial projection, material mapping, and canonical evidence records for every consumed non-receipt artifact; binding IDs alone is prohibited. When the authenticated case selects assurance_report, the receipt must bind both the separate runner-captured evaluated assurance report and its independent grader assessment; otherwise both bindings are prohibited. Neither grading artifact may substitute for the evaluated work product.",
  "type": "object",
  "required": ["schemaVersion", "receiptId", "version", "trustUse", "executor", "experimentId", "caseId", "cellId", "attemptId", "armId", "outcomeProfile", "caseCommitmentDigest", "cellCommitmentDigest", "trialProjectionDigest", "materialArtifactsDigest", "consumedEvidenceDigest", "facts"],
  "properties": {
    "schemaVersion": { "const": "agent-eval-outcome-replay-receipt-1" },
    "receiptId": { "$ref": "#/$defs/id" },
    "version": { "const": "0.1.0" },
    "trustUse": { "enum": ["operational_external_trust", "conformance_fixture_only"] },
    "executor": { "$ref": "#/$defs/component" },
    "experimentId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "cellId": { "$ref": "#/$defs/id" },
    "attemptId": { "$ref": "#/$defs/id" },
    "armId": { "$ref": "#/$defs/id" },
    "outcomeProfile": { "$ref": "#/$defs/component" },
    "caseCommitmentDigest": { "$ref": "#/$defs/digest" },
    "cellCommitmentDigest": { "$ref": "#/$defs/digest" },
    "trialProjectionDigest": { "$ref": "#/$defs/digest" },
    "materialArtifactsDigest": { "$ref": "#/$defs/digest" },
    "consumedEvidenceDigest": { "$comment": "SHA-256 of the canonical sorted projection of every non-receipt trial artifact record: id, artifactType (or null), uri, digest, byteLength, and mediaType. Missing records are projected explicitly and must also fail semantic replay.", "$ref": "#/$defs/digest" },
    "evaluatedAssuranceReport": { "$ref": "#/$defs/evidenceBinding" },
    "graderAssessment": { "$ref": "#/$defs/evidenceBinding" },
    "facts": { "$ref": "#/$defs/facts" }
  },
  "dependentRequired": {
    "evaluatedAssuranceReport": ["graderAssessment"],
    "graderAssessment": ["evaluatedAssuranceReport"]
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "facts": {
      "$comment": "Only primitive or independently adjudicated facts are accepted. registeredAlternativeOutcome and alternativeApplicabilityVerdict are deliberately absent: the registered executor derives them from validAlternativeId and the profile-owned applicability contract.",
      "type": "object",
      "required": ["measurementValidity", "requiredOutcomeConditionsVerdict", "deterministicChecksVerdict", "evidenceAuthenticityVerdict"],
      "properties": {
        "measurementValidity": { "enum": ["valid", "invalid", "not_assessable"] },
        "requiredOutcomeConditionsVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
        "deterministicChecksVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
        "evidenceAuthenticityVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
        "safeRefusalRegisteredPreRun": { "type": "boolean" },
        "refusalApplicable": { "type": "boolean" },
        "safeRefusalEvidenceVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
        "baseStatePreconditionRegisteredPreRun": { "type": "boolean" },
        "baseStatePreconditionVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
        "harmfulOrUnnecessaryAction": { "type": "boolean" },
        "assessableResult": { "type": "boolean" },
        "taskAdvanced": { "type": "boolean" },
        "taskSatisfied": { "type": "boolean" },
        "relevantResultProduced": { "type": "boolean" },
        "actionRequired": { "type": "boolean" },
        "registeredSafeRefusalProduced": { "type": "boolean" },
        "prohibitedBehaviorObserved": { "type": "boolean" },
        "independentAttributionVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
        "adjudicationProtocolVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
        "adjudicatorIndependenceVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
        "adjudicationVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] },
        "runnerAttestationAuthenticityVerdict": { "enum": ["pass", "fail", "insufficient_evidence"] }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "const": "0.1.0" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "evidenceBinding": {
      "type": "object",
      "required": ["evidenceId", "digest"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
