{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:scorecard:1",
  "title": "Sealed-run evaluation scorecard",
  "type": "object",
  "required": ["schemaVersion", "experiment", "arms", "comparativeDesign", "gateRegistry", "governanceStatusRegistry", "claims", "claimResults", "caseResults", "attemptIntegrity", "metrics", "evidenceManifest", "provenance", "digest", "signature"],
  "properties": {
    "schemaVersion": { "const": "agent-eval-scorecard-1" },
    "experiment": {
      "$comment": "Semantic validation must require caseProfiles to exactly match the sealed pre-run bindings and every cell's profile fields.",
      "type": "object", "required": ["id", "manifestDigest", "suite", "caseSetDigest", "assuranceLevel", "runMode", "claimEligibility", "riskAssessment", "effectiveRiskTier", "caseProfiles", "intendedUse", "effectiveRiskRange", "scheduledSetCommitment", "startedAt", "closedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "manifestDigest": { "$ref": "#/$defs/digest" },
        "suite": { "$ref": "#/$defs/versionedArtifactPointer" }, "caseSetDigest": { "$ref": "#/$defs/digest" },
        "assuranceLevel": { "enum": ["A0", "A1", "A2", "A3"] }, "runMode": { "enum": ["diagnostic_run", "evaluation"] }, "claimEligibility": { "enum": ["none", "claims_eligible"] },
        "riskAssessment": { "$comment": "The exact authenticated risk-assessment identity sealed by the pre-run manifest.", "$ref": "#/$defs/versionedArtifactPointer" },
        "effectiveRiskTier": { "$comment": "Equals the exact tier in both the sealed pre-run manifest and risk assessment.", "enum": ["low", "medium", "high", "critical"] },
        "caseProfiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/caseProfile" } }, "intendedUse": { "type": "string", "minLength": 1 },
        "effectiveRiskRange": { "$comment": "Eligibility boundary projected from the bound profiles; this is not the experiment's actual tier.", "type": "array", "minItems": 1, "items": { "enum": ["low", "medium", "high", "critical"] }, "uniqueItems": true },
        "scheduledSetCommitment": { "$ref": "#/$defs/artifactPointer" },
        "startedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }, "closedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }
      },
      "additionalProperties": false
    },
    "arms": { "$comment": "Semantic validation must reject duplicate arm IDs.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/arm" } },
    "comparativeDesign": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/comparativeDesign" }] },
    "gateRegistry": { "$ref": "#/$defs/artifactPointer" },
    "governanceStatusRegistry": { "$ref": "#/$defs/artifactPointer" },
    "claims": {
      "$comment": "Semantic validation must reject duplicate claim IDs.",
      "type": "array", "items": { "$ref": "#/$defs/claim" }
    },
    "claimResults": {
      "$comment": "Semantic validation must enforce exactly one result per claims[] ID and reject unknown or duplicate claimId values.",
      "type": "array", "items": { "$ref": "#/$defs/claimResult" }
    },
    "caseResults": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/caseResult" } },
    "attemptIntegrity": { "$ref": "#/$defs/attemptIntegrity" },
    "metrics": { "$ref": "#/$defs/runMetrics" },
    "evidenceManifest": {
      "$comment": "Semantic validation must reject duplicate evidence artifact IDs even when the remaining object fields differ.",
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "urn:agent-evals-standard:schema:evidence-artifact:1" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "digest": { "$ref": "#/$defs/digest" },
    "signature": { "$ref": "urn:agent-evals-standard:schema:signature-profile:1#/$defs/signature" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "claimResults": { "type": "array", "contains": { "type": "object", "properties": { "status": { "const": "supported" } }, "required": ["status"] } } }, "required": ["claimResults"] },
      "then": { "type": "object", "properties": { "attemptIntegrity": { "type": "object", "properties": { "status": { "const": "valid" } } } } }
    },
    {
      "if": { "type": "object", "properties": { "claims": { "type": "array", "contains": { "type": "object", "properties": { "type": { "const": "governance_evidence" } }, "required": ["type"] } } }, "required": ["claims"] },
      "then": { "type": "object", "properties": { "provenance": { "type": "object", "properties": { "decisionPlan": {} }, "required": ["decisionPlan"] } } }
    },
    {
      "if": { "type": "object", "properties": { "comparativeDesign": { "type": "object" } }, "required": ["comparativeDesign"] },
      "then": { "type": "object", "properties": { "arms": { "type": "array", "minItems": 2 } } }
    },
    {
      "if": { "type": "object", "properties": { "experiment": { "type": "object", "properties": { "assuranceLevel": { "const": "A0" } }, "required": ["assuranceLevel"] } }, "required": ["experiment"] },
      "then": { "type": "object", "properties": { "experiment": { "type": "object", "properties": { "runMode": { "const": "diagnostic_run" }, "claimEligibility": { "const": "none" }, "caseProfiles": { "type": "array", "minItems": 1, "items": { "type": "object", "properties": { "bindingUse": { "const": "diagnostic_only" } } } } } }, "claims": { "type": "array", "maxItems": 0 }, "claimResults": { "type": "array", "maxItems": 0 } } },
      "else": { "type": "object", "properties": { "experiment": { "type": "object", "properties": { "runMode": { "const": "evaluation" }, "claimEligibility": { "const": "claims_eligible" }, "caseProfiles": { "type": "array", "minItems": 1, "items": { "type": "object", "properties": { "bindingUse": { "const": "claims_eligible" } } } } } }, "claims": { "type": "array", "minItems": 1 }, "claimResults": { "type": "array", "minItems": 1 } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifactPointer": { "type": "object", "required": ["id", "uri", "digest"], "properties": { "id": { "$ref": "#/$defs/id" }, "uri": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    "versionedArtifactPointer": { "type": "object", "required": ["id", "version", "uri", "digest"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 }, "uri": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    "component": { "type": "object", "required": ["id", "version", "digest"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    "caseProfile": { "type": "object", "required": ["caseId", "bindingUse", "evaluationProfile", "effectiveProfileDigest", "outcomeProfile"], "properties": { "caseId": { "$ref": "#/$defs/id" }, "bindingUse": { "enum": ["diagnostic_only", "claims_eligible"] }, "evaluationProfile": { "$ref": "#/$defs/component" }, "effectiveProfileDigest": { "$ref": "#/$defs/digest" }, "outcomeProfile": { "$ref": "#/$defs/component" } }, "additionalProperties": false },
    "arm": {
      "type": "object", "required": ["id", "label", "treatmentRole", "model", "agentConfiguration", "prompts", "policies", "harness", "adapter", "tools", "permissions", "budgets", "retrieval", "memory", "agentVisibleProjection", "environment", "externalServices", "graderSet", "identityDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "label": { "type": "string", "minLength": 1 }, "treatmentRole": { "enum": ["single", "baseline", "treatment", "active_comparator"] },
        "model": { "$ref": "#/$defs/component" }, "agentConfiguration": { "$ref": "#/$defs/component" }, "prompts": { "$ref": "#/$defs/component" }, "policies": { "$ref": "#/$defs/component" },
        "harness": { "$ref": "#/$defs/component" }, "adapter": { "$ref": "#/$defs/component" }, "tools": { "$ref": "#/$defs/component" }, "permissions": { "$ref": "#/$defs/component" }, "budgets": { "$ref": "#/$defs/component" },
        "retrieval": { "$ref": "#/$defs/component" }, "memory": { "$ref": "#/$defs/component" }, "agentVisibleProjection": { "$ref": "#/$defs/component" },
        "environment": { "$ref": "#/$defs/component" }, "externalServices": { "$ref": "#/$defs/component" }, "graderSet": { "$ref": "#/$defs/component" },
        "identityDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "pairedRepetition": { "type": "object", "required": ["repetition", "seed"], "properties": { "repetition": { "type": "integer", "minimum": 1 }, "seed": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
    "pairedUnit": { "type": "object", "required": ["caseId", "blockId", "repetitions"], "properties": { "caseId": { "$ref": "#/$defs/id" }, "blockId": { "$ref": "#/$defs/id" }, "repetitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pairedRepetition" }, "uniqueItems": true } }, "additionalProperties": false },
    "comparativeDesign": {
      "$comment": "pairedUnits is the exact sealed pre-run case/block/repetition/seed matrix. Semantic validation requires one and only one cell for every comparator arm and paired tuple and rejects marginally equal but differently paired sets.",
      "type": "object", "required": ["id", "comparatorArmIds", "treatmentBundle", "treatmentBundleDigest", "pairedUnits", "randomizationOrOrdering", "resetAndCarryoverRules", "interferenceControls", "sharedMeasurementIdentity", "hypotheses", "statisticalPlan"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "comparatorArmIds": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "treatmentBundle": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "treatmentBundleDigest": { "$ref": "#/$defs/digest" },
        "pairedUnits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pairedUnit" }, "uniqueItems": true },
        "randomizationOrOrdering": { "$ref": "#/$defs/artifactPointer" }, "resetAndCarryoverRules": { "$ref": "#/$defs/artifactPointer" }, "interferenceControls": { "$ref": "#/$defs/artifactPointer" },
        "sharedMeasurementIdentity": { "$ref": "#/$defs/digest" }, "hypotheses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "statisticalPlan": { "$ref": "#/$defs/artifactPointer" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["id", "type", "intendedDecision", "construct", "estimand", "direction", "successDefinition", "analysisUnit", "targetPopulation", "samplingFrame", "representedStrata", "slice", "weights", "coverageGaps", "assuranceLevel", "effectiveRiskRange", "exposureBoundary", "evaluationProfile", "outcomeProfiles", "comparatorArmIds", "threshold", "confidenceLevel", "statisticalPlan", "decisionRule"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "type": "string", "pattern": "^(capability|reliability|comparative|quality|safety|cost|governance_evidence|[A-Za-z0-9][A-Za-z0-9_.-]*:[A-Za-z0-9_.-]+)$" },
        "intendedDecision": { "type": "string", "minLength": 1 }, "construct": { "type": "string", "minLength": 1 }, "estimand": { "type": "string", "minLength": 1 }, "direction": { "enum": ["positive", "harm", "difference"] },
        "successDefinition": { "$ref": "#/$defs/successDefinition" }, "analysisUnit": { "type": "string", "minLength": 1 }, "targetPopulation": { "type": "string", "minLength": 1 }, "samplingFrame": { "type": "string", "minLength": 1 },
        "representedStrata": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "slice": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "weights": { "$ref": "#/$defs/artifactPointer" },
        "coverageGaps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "assuranceLevel": { "enum": ["A0", "A1", "A2", "A3"] }, "effectiveRiskRange": { "type": "array", "minItems": 1, "items": { "enum": ["low", "medium", "high", "critical"] }, "uniqueItems": true },
        "exposureBoundary": { "$ref": "#/$defs/artifactPointer" }, "evaluationProfile": { "$ref": "#/$defs/component" }, "outcomeProfiles": { "$comment": "Semantic validation must reject duplicate outcome-profile IDs or digests and require every eligible cell to use one of these exact bindings.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
        "comparatorArmIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "threshold": { "type": ["number", "null"] },
        "confidenceLevel": { "type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1 }, "statisticalPlan": { "$ref": "#/$defs/artifactPointer" }, "decisionRule": { "$ref": "#/$defs/versionedArtifactPointer" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "governance_evidence" } }, "required": ["type"] },
          "then": { "type": "object", "properties": { "successDefinition": { "type": "object", "properties": { "id": { "const": "accepted-outcome-v1" } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "comparative" } }, "required": ["type"] },
          "then": { "type": "object", "properties": { "comparatorArmIds": { "type": "array", "minItems": 2 }, "direction": { "const": "difference" } } }
        }
      ],
      "additionalProperties": false
    },
    "claimResult": {
      "type": "object", "required": ["claimId", "status", "reasonIds", "eligibleCellIds", "successAssignments", "estimate", "interval", "identificationBounds", "missingness", "coverage", "decisionRuleResult"],
      "properties": {
        "claimId": { "$ref": "#/$defs/id" }, "status": { "enum": ["supported", "insufficient_evidence", "not_applicable"] }, "reasonIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "eligibleCellIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "successAssignments": { "type": "array", "items": { "type": "object", "required": ["cellId", "success", "evidenceIds"], "properties": { "cellId": { "$ref": "#/$defs/id" }, "success": { "type": "boolean" }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true } }, "additionalProperties": false } },
        "estimate": { "type": ["number", "null"] }, "interval": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/interval" }] }, "identificationBounds": { "$ref": "#/$defs/bound" },
        "missingness": { "$ref": "#/$defs/artifactPointer" }, "coverage": { "$ref": "#/$defs/artifactPointer" }, "decisionRuleResult": { "enum": ["pass", "fail", "insufficient_evidence", "not_applicable"] }
      },
      "allOf": [{ "if": { "properties": { "status": { "const": "supported" } }, "required": ["status"] }, "then": { "properties": { "estimate": { "type": "number" }, "interval": { "$ref": "#/$defs/interval" }, "decisionRuleResult": { "const": "pass" } } }, "else": { "properties": { "estimate": { "type": "null" } } } }],
      "additionalProperties": false
    },
    "successDefinition": { "type": "object", "required": ["id", "version"], "properties": { "id": { "enum": ["functional-outcome-v1", "accepted-outcome-v1"] }, "version": { "const": "0.1.0" } }, "additionalProperties": false },
    "interval": { "type": "object", "required": ["method", "version", "confidenceLevel", "lower", "upper"], "properties": { "method": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "confidenceLevel": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }, "lower": { "type": "number" }, "upper": { "type": "number" } }, "additionalProperties": false },
    "bound": { "type": "object", "required": ["method", "version", "direction", "lower", "upper"], "properties": { "method": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "direction": { "enum": ["positive", "harm", "difference"] }, "lower": { "type": "number" }, "upper": { "type": "number" } }, "additionalProperties": false },
    "caseResult": {
      "type": "object", "required": ["case", "stratum", "weight", "gateCoverage", "governanceCoverage", "cells", "statistics", "contributions"],
      "properties": {
        "case": { "$ref": "#/$defs/caseIdentity" }, "stratum": { "type": "string", "minLength": 1 }, "weight": { "type": "number", "exclusiveMinimum": 0 },
        "gateCoverage": { "$ref": "#/$defs/registryCoverage" }, "governanceCoverage": { "$ref": "#/$defs/registryCoverage" },
        "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cellResult" } },
        "statistics": { "type": "array", "items": { "$ref": "#/$defs/statistic" } },
        "contributions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["number", "null"] } }
      },
      "additionalProperties": false
    },
    "caseIdentity": {
      "type": "object", "required": ["id", "version", "digest", "riskTier", "memberships", "sliceIds", "qaRecord"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" },
        "riskTier": { "enum": ["low", "medium", "high", "critical"] }, "memberships": { "type": "array", "minItems": 1, "items": { "enum": ["development", "held_out", "smoke", "regression"] }, "uniqueItems": true },
        "sliceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "qaRecord": { "$ref": "#/$defs/artifactPointer" }
      },
      "additionalProperties": false
    },
    "registryCoverage": {
      "type": "object", "required": ["registry", "expectedIds", "expectedDigest", "evaluatedIds", "evaluatedDigest"],
      "properties": {
        "registry": { "$ref": "#/$defs/component" }, "expectedIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "expectedDigest": { "$ref": "#/$defs/digest" }, "evaluatedIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "evaluatedDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "cellResult": {
      "type": "object", "required": ["cellId", "armId", "evaluationProfileDigest", "outcomeProfile", "repetition", "blockId", "seed", "state", "lineage", "selectedAttemptId", "trialResult"],
      "properties": {
        "cellId": { "$ref": "#/$defs/id" }, "armId": { "$ref": "#/$defs/id" }, "evaluationProfileDigest": { "$ref": "#/$defs/digest" }, "outcomeProfile": { "$ref": "#/$defs/component" }, "repetition": { "type": "integer", "minimum": 1 }, "blockId": { "$ref": "#/$defs/id" }, "seed": { "$ref": "#/$defs/id" },
        "state": { "$comment": "Measurement state only. Success and failure are claim-specific and belong in claimResults[].successAssignments.", "enum": ["resolved", "unresolved"] },
        "lineage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "selectedAttemptId": { "type": ["string", "null"] }, "trialResult": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/trialResult" }] }
      },
      "allOf": [{ "if": { "properties": { "state": { "const": "unresolved" } } }, "then": { "properties": { "selectedAttemptId": { "type": "null" }, "trialResult": { "type": "null" } } }, "else": { "properties": { "selectedAttemptId": { "type": "string", "minLength": 1 }, "trialResult": { "$ref": "#/$defs/trialResult" } } } }],
      "additionalProperties": false
    },
    "trialResult": {
      "type": "object", "required": ["attemptId", "validity", "functional", "accepted", "primaryOutcome", "profileOutcome", "terminalState", "validAlternativeId", "evidenceModeVerdicts", "failureCauses", "hardGates", "governanceStatuses", "decisionSurfaces", "transcriptEvidence", "interactionEvidence", "metrics", "artifactIds"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/id" }, "validity": { "enum": ["valid", "invalid"] }, "functional": { "type": "boolean" }, "accepted": { "type": "boolean" },
        "primaryOutcome": { "$ref": "#/$defs/primaryOutcome" },
        "profileOutcome": { "$comment": "Preserves the exact profile-native result that was normalized into primaryOutcome. Semantic validation resolves id exactly once in the cell's authenticated outcome profile, requires its baseOutcome to equal primaryOutcome, requires one registered substatus when that native outcome declares any, and otherwise requires null.", "$ref": "#/$defs/profileOutcome" },
        "terminalState": { "$ref": "#/$defs/outcomeTerminalState" },
        "validAlternativeId": { "$comment": "Semantic validation must resolve a non-null ID in the cell's exact outcome-profile binding and require its registered primaryOutcome to match this trial.", "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
        "evidenceModeVerdicts": { "$comment": "Semantic validation must reject duplicate mode IDs, resolve each ID in the cell's exact outcome profile, and require every mode used by the assigned outcome rule.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceModeVerdict" } },
        "failureCauses": { "type": "array", "items": { "$ref": "#/$defs/failureCause" } },
        "hardGates": { "$comment": "Semantic validation must reconcile exactly the expected core, profile, risk, and case gate registry.", "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/hardGate" } },
        "governanceStatuses": { "$comment": "Semantic validation must reconcile exactly the expected four core statuses plus registered extensions.", "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/governanceStatus" } },
        "decisionSurfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decisionSurfaceResult" } },
        "transcriptEvidence": { "$ref": "#/$defs/evidenceCompleteness" }, "interactionEvidence": { "$ref": "#/$defs/evidenceCompleteness" },
        "metrics": { "type": "object", "minProperties": 1 }, "artifactIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "outcomeReplay": { "$comment": "Required semantically for every resolved trial used by a claim. The validator resolves executor identity only from the distribution registry and receipt trust only from verifier configuration; neither is discovered from this claimant-controlled object.", "$ref": "#/$defs/outcomeReplay" }
      },
      "allOf": [
        { "if": { "type": "object", "properties": { "validity": { "const": "invalid" } } }, "then": { "type": "object", "properties": { "functional": { "const": false }, "accepted": { "const": false }, "primaryOutcome": { "const": "infra_failure" }, "terminalState": { "const": "measurement_unavailable" } } } },
        {
          "if": { "type": "object", "properties": { "functional": { "const": true } }, "required": ["functional"] },
          "then": {
            "type": "object",
            "properties": {
              "validity": { "const": "valid" },
              "primaryOutcome": { "enum": ["solved", "correct_refusal", "already_satisfied"] },
              "hardGates": { "type": "array", "items": { "type": "object", "properties": { "status": { "const": "pass" } } } },
              "transcriptEvidence": { "type": "object", "properties": { "status": { "const": "complete" } } },
              "evidenceModeVerdicts": { "type": "array", "contains": { "type": "object", "properties": { "status": { "const": "pass" } }, "required": ["status"] } }
            }
          }
        },
        { "if": { "type": "object", "properties": { "accepted": { "const": true } }, "required": ["accepted"] }, "then": { "type": "object", "properties": { "functional": { "const": true }, "governanceStatuses": { "type": "array", "items": { "type": "object", "properties": { "state": { "const": "not_applicable" } } } } } } },
        { "if": { "type": "object", "properties": { "primaryOutcome": { "const": "solved" } }, "required": ["primaryOutcome"] }, "then": { "type": "object", "properties": { "terminalState": { "const": "task_satisfied" }, "validAlternativeId": { "type": "null" } } } },
        { "if": { "type": "object", "properties": { "primaryOutcome": { "const": "correct_refusal" } }, "required": ["primaryOutcome"] }, "then": { "type": "object", "properties": { "terminalState": { "const": "safe_refusal" }, "validAlternativeId": { "type": "string", "minLength": 1 } } } },
        { "if": { "type": "object", "properties": { "primaryOutcome": { "const": "already_satisfied" } }, "required": ["primaryOutcome"] }, "then": { "type": "object", "properties": { "terminalState": { "const": "base_state_already_satisfied" }, "validAlternativeId": { "type": "string", "minLength": 1 } } } },
