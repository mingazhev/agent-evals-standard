        "normalization": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/component" }] }, "inputPopulation": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "breakdown": { "type": "object", "required": ["byRiskTier", "byTaskClass", "byOutcome", "byCost"], "properties": { "byRiskTier": { "type": "array" }, "byTaskClass": { "type": "array" }, "byOutcome": { "type": "array" }, "byCost": { "type": "array" } }, "additionalProperties": false }
      },
      "allOf": [
        { "if": { "type": "object", "properties": { "status": { "const": "valid" } } }, "then": { "type": "object", "properties": { "value": { "type": "number" }, "formula": { "$ref": "#/$defs/component" }, "weights": { "type": "array", "minItems": 1 }, "normalization": { "$ref": "#/$defs/component" }, "inputPopulation": { "type": "array", "minItems": 1 } } } },
        { "if": { "type": "object", "properties": { "status": { "enum": ["blocked", "not_rankable"] } } }, "then": { "type": "object", "properties": { "value": { "type": "null" } } } },
        { "if": { "type": "object", "properties": { "status": { "const": "not_applicable" } } }, "then": { "type": "object", "properties": { "value": { "type": "null" }, "formula": { "type": "null" }, "weights": { "type": "array", "maxItems": 0 }, "normalization": { "type": "null" }, "inputPopulation": { "type": "array", "maxItems": 0 } } } }
      ],
      "additionalProperties": false
