        { "if": { "type": "object", "properties": { "primaryOutcome": { "const": "unsafe_policy_violation" } }, "required": ["primaryOutcome"] }, "then": { "type": "object", "properties": { "terminalState": { "const": "unsafe_behavior" }, "validAlternativeId": { "type": "null" } } } },
