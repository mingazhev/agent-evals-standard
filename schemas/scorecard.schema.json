    "evidenceModeVerdict": { "$comment": "evidenceKindBindings is exact: its kind IDs equal the selected profile mode's requiredEvidenceKinds, its flattened evidence IDs equal evidenceIds without passengers, and the distribution-owned replay executor validates each artifact against the registered kind semantics.", "type": "object", "required": ["modeId", "status", "evidenceIds", "evidenceKindBindings"], "properties": { "modeId": { "$ref": "#/$defs/id" }, "status": { "enum": ["pass", "fail", "invalid", "not_applicable"] }, "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "evidenceKindBindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceKindBinding" } } }, "allOf": [{ "if": { "type": "object", "properties": { "status": { "enum": ["pass", "fail", "invalid"] } }, "required": ["status"] }, "then": { "type": "object", "properties": { "evidenceIds": { "type": "array", "minItems": 1 } } } }], "additionalProperties": false },
    "evidenceKindBinding": { "type": "object", "required": ["kindId", "evidenceIds"], "properties": { "kindId": { "$ref": "#/$defs/id" }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true } }, "additionalProperties": false },
    "failureCause": { "$comment": "id is a cause ID from the bound outcome profile's failure taxonomy. Semantic validation must reject unknown IDs and reconcile failed gates through failureCauseId.", "type": "object", "required": ["id", "taxonomy", "evidenceIds"], "properties": { "id": { "$ref": "#/$defs/id" }, "taxonomy": { "$ref": "#/$defs/component" }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true } }, "additionalProperties": false },
    "hardGate": { "$comment": "failureCauseId identifies taxonomy detail and is never a primary outcome. Semantic validation must require every non-null ID to occur in trialResult.failureCauses.", "type": "object", "required": ["id", "status", "backingEvidenceIds", "assignmentEvidenceId", "triggerEvidenceId", "failureCauseId"], "properties": { "id": { "$ref": "#/$defs/id" }, "status": { "enum": ["pass", "fail", "invalid"] }, "backingEvidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "assignmentEvidenceId": { "$ref": "#/$defs/id" }, "triggerEvidenceId": { "$ref": "#/$defs/id" }, "failureCauseId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" } }, "allOf": [{ "if": { "type": "object", "properties": { "status": { "const": "pass" } }, "required": ["status"] }, "then": { "type": "object", "properties": { "failureCauseId": { "type": "null" } } }, "else": { "type": "object", "properties": { "failureCauseId": { "type": "string", "minLength": 1 } } } }], "additionalProperties": false },
    "governanceStatus": { "$comment": "Version 0.1.0 prohibits waivers. A resolved status is retained for governance-ledger reporting but cannot close accepted-outcome-v1 inside a trial; only not_applicable statuses can coexist with accepted=true.", "type": "object", "required": ["id", "state", "triggerEvidenceId", "findingEvidenceId"], "properties": { "id": { "enum": ["security_review_required", "manual_review_required", "data_owner_review_required", "risk_acceptance_required"] }, "state": { "enum": ["not_applicable", "open", "resolved", "waived"] }, "triggerEvidenceId": { "$ref": "#/$defs/id" }, "findingEvidenceId": { "$ref": "#/$defs/id" }, "resolutionEventId": { "$ref": "#/$defs/id" } }, "allOf": [{ "if": { "type": "object", "properties": { "state": { "enum": ["resolved", "waived"] } } }, "then": { "type": "object", "properties": { "resolutionEventId": {} }, "required": ["resolutionEventId"] } }], "additionalProperties": false },
    "decisionSurfaceResult": { "type": "object", "required": ["surfaceId", "materiality", "applicability", "coverage", "status", "evidenceIds"], "properties": { "surfaceId": { "$ref": "#/$defs/id" }, "materiality": { "enum": ["outcome", "risk", "diagnostic"] }, "applicability": { "enum": ["applicable", "not_applicable", "indeterminate"] }, "coverage": { "enum": ["checked", "covered_by_final_state", "not_applicable", "declared_gap", "not_determined"] }, "status": { "enum": ["pass", "fail", "not_applicable", "insufficient_evidence", "not_evaluated"] }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "claimRestrictionIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true } }, "allOf": [{ "if": { "type": "object", "properties": { "applicability": { "const": "indeterminate" } } }, "then": { "type": "object", "properties": { "coverage": { "const": "not_determined" }, "status": { "const": "insufficient_evidence" } } } }, { "if": { "type": "object", "properties": { "coverage": { "const": "declared_gap" } } }, "then": { "type": "object", "required": ["claimRestrictionIds"], "properties": { "claimRestrictionIds": {}, "status": { "const": "not_evaluated" } } } }], "additionalProperties": false },
    "evidenceCompleteness": { "type": "object", "required": ["status", "artifactIds"], "properties": { "status": { "enum": ["complete", "partial", "unavailable", "not_applicable"] }, "artifactIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true } }, "allOf": [{ "if": { "type": "object", "properties": { "status": { "const": "complete" } } }, "then": { "type": "object", "properties": { "artifactIds": { "type": "array", "minItems": 1 } } } }], "additionalProperties": false },
    "outcomeReplay": {
