    "attemptRecord": { "type": "object", "required": ["attemptId", "cellId", "terminalState", "measurementValidity", "parentAttemptId", "retryReason", "startedAt", "finishedAt", "artifactIds", "metrics"], "properties": { "attemptId": { "$ref": "#/$defs/id" }, "cellId": { "$ref": "#/$defs/id" }, "terminalState": { "enum": ["completed", "interrupted", "missing_capture"] }, "measurementValidity": { "enum": ["valid", "invalid", "not_assessable"] }, "parentAttemptId": { "type": ["string", "null"] }, "retryReason": { "type": ["string", "null"] }, "startedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }, "finishedAt": { "type": "string", "format": "date-time", "pattern": "Z$" }, "artifactIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }, "metrics": { "type": "object", "minProperties": 1 } }, "allOf": [{ "if": { "properties": { "terminalState": { "const": "completed" } } }, "then": { "properties": { "measurementValidity": { "enum": ["valid", "invalid"] } } }, "else": { "properties": { "measurementValidity": { "const": "not_assessable" } } } }], "additionalProperties": false },
