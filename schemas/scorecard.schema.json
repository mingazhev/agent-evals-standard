{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-evals-standard:schema:scorecard:1",
  "title": "Scorecard",
  "$comment": "Requirements I1, GATE-001, OUT-001, CLAIM-001, CLAIM-002, I6, STAT-001, STAT-002, STAT-003. Hard-gate results, primary outcomes, claim status, and decision verdict are separate fields. Semantic checks: every count, per-case row, point estimate, bound, and interval is reproducible from the attempt ledger and run manifest under stat-defaults-v1 and the sealed overrides.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "runManifest",
    "attemptLedger",
    "caseQaRecords",
    "statistics",
    "accounting",
    "outcomes",
    "hardGateFailures",
    "perCase",
    "metrics",
    "claims",
    "decisionVerdict"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-eval-scorecard-1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "runManifest": {
      "$ref": "#/$defs/ref"
    },
    "attemptLedger": {
      "$ref": "#/$defs/ref"
    },
    "caseQaRecords": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "statistics": {
      "type": "object",
      "required": [
        "defaults",
        "overrides"
      ],
      "properties": {
        "defaults": {
          "const": "stat-defaults-v1"
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "accounting": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "armId",
          "scheduledCells",
          "physicalAttempts",
          "validTrials",
          "invalidAttempts",
          "replacementAttempts",
          "unresolvedCells"
        ],
        "properties": {
          "armId": {
            "$ref": "#/$defs/id"
          },
          "scheduledCells": {
            "$ref": "#/$defs/count"
          },
          "physicalAttempts": {
            "$ref": "#/$defs/count"
          },
          "validTrials": {
            "$ref": "#/$defs/count"
          },
          "invalidAttempts": {
            "$ref": "#/$defs/count"
          },
          "replacementAttempts": {
            "$ref": "#/$defs/count"
          },
          "unresolvedCells": {
            "$ref": "#/$defs/count"
          }
        },
        "additionalProperties": false
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "armId",
          "solved",
          "correct_refusal",
          "already_satisfied",
          "partial",
          "failed",
          "no_relevant_result",
          "unsafe_policy_violation"
        ],
        "properties": {
          "armId": {
            "$ref": "#/$defs/id"
          },
          "solved": {
            "$ref": "#/$defs/count"
          },
          "correct_refusal": {
            "$ref": "#/$defs/count"
          },
          "already_satisfied": {
            "$ref": "#/$defs/count"
          },
          "partial": {
            "$ref": "#/$defs/count"
          },
          "failed": {
            "$ref": "#/$defs/count"
          },
          "no_relevant_result": {
            "$ref": "#/$defs/count"
          },
          "unsafe_policy_violation": {
            "$ref": "#/$defs/count"
          }
        },
        "additionalProperties": false
      }
    },
    "hardGateFailures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "armId",
          "gateId",
          "count"
        ],
        "properties": {
          "armId": {
            "$ref": "#/$defs/id"
          },
          "gateId": {
            "$ref": "#/$defs/id"
          },
          "count": {
            "$ref": "#/$defs/count"
          }
        },
        "additionalProperties": false
      }
    },
    "perCase": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "results"
        ],
        "properties": {
          "caseId": {
            "$ref": "#/$defs/id"
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "armId",
                "scheduled",
                "resolved",
                "successes"
              ],
              "properties": {
                "armId": {
                  "$ref": "#/$defs/id"
                },
                "scheduled": {
                  "$ref": "#/$defs/count"
                },
                "resolved": {
                  "$ref": "#/$defs/count"
                },
                "successes": {
                  "$ref": "#/$defs/count"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "estimand",
          "armId",
          "comparatorArmId",
          "cases",
          "estimate",
          "identificationBounds",
          "interval"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "estimand": {
            "enum": [
              "pass_at_1",
              "pass_hat_k",
              "paired_difference_pass_at_1"
            ]
          },
          "k": {
            "type": "integer",
            "minimum": 2
          },
          "armId": {
            "$ref": "#/$defs/id"
          },
          "comparatorArmId": {
            "oneOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          },
          "cases": {
            "type": "integer",
            "minimum": 1
          },
          "identificationBounds": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "failureEndpoint",
                  "successEndpoint"
                ],
                "properties": {
                  "failureEndpoint": {
                    "type": "number"
                  },
                  "successEndpoint": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "interval": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "method",
                  "level",
                  "lower",
                  "upper"
                ],
                "properties": {
                  "method": {
                    "enum": [
                      "wilson",
                      "t_over_cases",
                      "t_over_paired_differences"
                    ]
                  },
                  "level": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1
                  },
                  "lower": {
                    "type": "number"
                  },
                  "upper": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "computed",
              "uncomputable"
            ]
          },
          "estimate": {
            "type": [
              "number",
              "null"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "computed"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "estimate": {
                  "type": "number"
                },
                "identificationBounds": {
                  "type": "object"
                },
                "interval": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "estimate": {
                  "type": "null"
                },
                "identificationBounds": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "interval": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "minItems": 1
                }
              },
              "required": [
                "reasons"
              ]
            }
          }
        ]
      }
    },
    "claims": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "metricId",
          "population",
          "restrictions"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "status": {
            "enum": [
              "supported",
              "not_supported",
              "insufficient_evidence",
              "reported_only"
            ]
          },
          "metricId": {
            "$ref": "#/$defs/id"
          },
          "population": {
            "type": "string",
            "minLength": 1
          },
          "restrictions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decisionVerdict": {
      "const": "not_applicable",
      "$comment": "A scorecard never decides; a decision is a governance-decision."
    },
    "governanceStatuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "enum": [
              "security_review_required",
              "manual_review_required",
              "data_owner_review_required",
              "risk_acceptance_required"
            ]
          },
          "status": {
            "enum": [
              "not_applicable",
              "open",
              "resolved",
              "waived"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "validity": {
      "type": "object",
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "armId",
          "tokens",
          "costUsd",
          "wallClockSeconds"
        ],
        "properties": {
          "armId": {
            "$ref": "#/$defs/id"
          },
          "tokens": {
            "$ref": "#/$defs/count"
          },
          "costUsd": {
            "type": "number",
            "minimum": 0
          },
          "wallClockSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "ref": {
      "type": "object",
      "required": [
        "path",
        "commit",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    }
  }
}
