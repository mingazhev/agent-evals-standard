{
  "schemaVersion": "repo-change-case-contract-1",
  "id": "repo-change-case-contract",
  "version": "0.1.0",
  "caseSchema": {
    "id": "urn:agent-evals-standard:schema:case:1",
    "version": "0.1.0"
  },
  "requiredCaseProperties": [
    "/evaluationProfile",
    "/outcomeProfile",
    "/capabilityFamilyIds",
    "/interactionModeId",
    "/workArtifactRegistry",
    "/workArtifactTypes",
    "/repository/workspaceManifest",
    "/scoring",
    "/artifactPolicy"
  ],
  "requiredProfileBindings": [
