        "expression": {
          "all": [
            {
              "fact": "measurementValidity",
              "operator": "equals",
              "expected": "valid"
            },
            {
              "fact": "requiredOutcomeConditionsVerdict",
              "operator": "equals",
              "expected": "pass"
            }
          ]
        }
      },
