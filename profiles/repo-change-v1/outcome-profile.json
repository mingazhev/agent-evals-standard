      "primaryOutcome": "already_satisfied",
      "applicabilityContract": {
        "id": "repo-change-base-state-applicability",
        "version": "0.1.0",
        "expression": {
          "all": [
            {
              "fact": "baseStatePreconditionRegisteredPreRun",
              "operator": "equals",
              "expected": true
            },
            {
              "fact": "baseStatePreconditionVerdict",
              "operator": "equals",
              "expected": "pass"
            }
          ]
        }
      },
      "evidenceModeIds": [
        "deterministic"
      ]
    }
  ],
