      "verdictRule": {
        "id": "hybrid-evidence-verdict",
        "version": "0.1.0",
        "expression": {
          "all": [
            {
              "fact": "deterministicChecksVerdict",
              "operator": "equals",
              "expected": "pass"
            },
            {
              "fact": "adjudicationVerdict",
              "operator": "equals",
              "expected": "pass"
            },
            {
              "fact": "evidenceAuthenticityVerdict",
              "operator": "equals",
              "expected": "pass"
            }
          ]
        }
      }
    },
    {
      "id": "measurement_failure_record",
      "version": "0.1.0",
      "requiredEvidenceKinds": [
        "runner-failure-record",
        "measurement-validity-record"
      ],
      "verdictRule": {
        "id": "measurement-failure-record-verdict",
        "version": "0.1.0",
        "expression": {
          "all": [
            {
              "fact": "runnerRecordAuthorizationVerdict",
              "operator": "equals",
              "expected": "pass"
            },
            {
              "any": [
                {
                  "fact": "measurementValidity",
                  "operator": "equals",
                  "expected": "invalid"
                },
                {
                  "fact": "measurementValidity",
                  "operator": "equals",
                  "expected": "not_assessable"
                }
              ]
            }
          ]
        }
      }
    }
