    {
      "id": "case.a2.valid",
      "path": "valid/case.a2.json",
      "schema": "schemas/case.schema.json",
      "valid": true,
      "illustrates": "an A2 case adds the workspace manifest, evaluation and outcome profiles, an active lifecycle with its QA record, contamination, leakage controls, a decision surface, and an exposure budget"
    },
    {
      "id": "case-qa.a2.valid",
      "path": "valid/case-qa.a2.json",
      "schema": "schemas/case-qa.schema.json",
      "valid": true,
      "illustrates": "an A2 Case QA record passes stages 3-8 (stage 7 with an alternative-valid-result probe), fixes a defect, and binds a grader validation and a decision-surface validation"
    },
    {
      "id": "scorecard.a2.valid",
      "path": "valid/scorecard.a2.json",
      "schema": "schemas/scorecard.schema.json",
      "valid": true,
      "illustrates": "an A2 scorecard adds governance statuses, validity, and per-arm telemetry to a computed metric"
    },
    {
      "id": "scorecard.uncomputable-metric.valid",
      "path": "valid/scorecard.uncomputable-metric.json",
      "schema": "schemas/scorecard.schema.json",
      "valid": true,
      "illustrates": "an arm with no valid trial in any scheduled cell makes its pass_at_1 metric uncomputable: null estimate and interval, reasons, and identification bounds [0, 1]"
    },
    {
      "id": "conformance-statement.conforming-with-failed-requirement",
      "path": "invalid/conformance-statement.conforming-with-failed-requirement.json",
      "schema": "schemas/conformance-statement.schema.json",
      "valid": false,
      "expectedError": "/verdict",
      "illustrates": "A1: a failed requirement row forces verdict nonconforming; conforming requires every row pass"
    },
    {
      "id": "evaluation-profile.general-agent-capability",
      "path": "invalid/evaluation-profile.general-agent-capability.json",
      "schema": "schemas/evaluation-profile.schema.json",
      "valid": false,
      "expectedError": "/capabilityFamilies/0",
      "illustrates": "SCOPE-002/SCOPE-003: a profile cannot add a capability outside the closed SDLC taxonomy"
    },
    {
      "id": "evidence-artifact.missing-byte-length",
      "path": "invalid/evidence-artifact.missing-byte-length.json",
      "schema": "schemas/evidence-artifact.schema.json",
      "valid": false,
      "expectedError": "byteLength",
      "illustrates": "EVID-001: digest-only metadata is not material evidence"
    },
    {
      "id": "run-manifest.a1-high-risk",
      "path": "invalid/run-manifest.a1-high-risk.json",
      "schema": "schemas/run-manifest.schema.json",
      "valid": false,
      "expectedError": "/effectiveRisk/tier",
      "illustrates": "A1 and A2 allow only low or medium effective risk; high and critical require A3"
    },
    {
      "id": "run-manifest.a2-missing-held-out",
      "path": "invalid/run-manifest.a2-missing-held-out.json",
      "schema": "schemas/run-manifest.schema.json",
      "valid": false,
      "expectedError": "heldOut",
      "illustrates": "A2 and above require the held-out budget and ledger refs"
    },
    {
      "id": "conformance-statement.a1-governance-eligible",
      "path": "invalid/conformance-statement.a1-governance-eligible.json",
      "schema": "schemas/conformance-statement.schema.json",
      "valid": false,
      "expectedError": "/restrictions/governanceUse",
      "illustrates": "A1 statements keep governanceUse prohibited; eligible needs A2 or above"
    },
    {
      "id": "scorecard.uncomputable-without-reasons",
      "path": "invalid/scorecard.uncomputable-without-reasons.json",
      "schema": "schemas/scorecard.schema.json",
      "valid": false,
      "expectedError": "reasons",
      "illustrates": "an uncomputable metric carries a null estimate and must state why in reasons"
    },
    {
      "id": "case-qa.active-failed-control",
      "path": "invalid/case-qa.active-failed-control.json",
      "schema": "schemas/case-qa.schema.json",
      "valid": false,
      "expectedError": "/knownGood/result",
      "illustrates": "CASE-004: actual failed controls may be recorded for rejected or quarantined cases, but an active case still requires knownGood pass and every knownBad fail."
    },
    {
      "id": "attempt-ledger.empty.valid",
      "path": "valid/attempt-ledger.empty.json",
      "schema": "schemas/attempt-ledger.schema.json",
      "valid": true,
      "illustrates": "A sealed run with no dispatched attempts has an empty ledger; its terminal digest is the genesis commitment and every scheduled cell remains unresolved."
    },
    {
      "id": "run-manifest.exploratory-threshold",
      "path": "invalid/run-manifest.exploratory-threshold.json",
      "schema": "schemas/run-manifest.schema.json",
      "valid": false,
      "expectedError": "/claims/0/decisionRule/kind",
      "illustrates": "Exploratory claims are report_only with a null threshold; only primary claims can test thresholds."
    },
    {
      "id": "scorecard.unsupported-interval",
      "path": "invalid/scorecard.unsupported-interval.json",
      "schema": "schemas/scorecard.schema.json",
      "valid": false,
      "expectedError": "/metrics/0/interval/method",
      "illustrates": "Statistical overrides cannot introduce an interval method outside the closed 0.1.0 method set."
    },
    {
      "id": "governance-decision.approve.valid",
      "path": "valid/governance-decision.approve.json",
      "schema": "schemas/governance-decision.schema.json",
      "valid": true,
      "illustrates": "An approval contains a complete post-decision assurance plan with each of the 13 required change triggers exactly once; the referenced evidence remains illustrative."
    }
